<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ══════════════════════════════════════════════════════════════
         PAGE / SHELL
    ══════════════════════════════════════════════════════════════════ -->

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding
            Light={StaticResource BackgroundLight},
            Dark={StaticResource BackgroundDark}}" />
    </Style>

    <!-- Shell chrome + tab bar colours -->
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding
            Light={StaticResource SurfaceLight},
            Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding
            Light={StaticResource OnSurfaceLight},
            Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding
            Light={StaticResource OnSurfaceLight},
            Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="Shell.DisabledColor" Value="{AppThemeBinding
            Light={StaticResource DividerLight},
            Dark={StaticResource DividerDark}}" />
        <Setter Property="Shell.UnselectedColor" Value="{AppThemeBinding
            Light={StaticResource TabBarUnselectedLight},
            Dark={StaticResource TabBarUnselectedDark}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <!-- Tab bar -->
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding
            Light={StaticResource TabBarBgLight},
            Dark={StaticResource TabBarBgDark}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding
            Light={StaticResource TabBarSelectedLight},
            Dark={StaticResource TabBarSelectedDark}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding
            Light={StaticResource TabBarSelectedLight},
            Dark={StaticResource TabBarSelectedDark}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding
            Light={StaticResource TabBarUnselectedLight},
            Dark={StaticResource TabBarUnselectedDark}}" />
    </Style>

    <!-- ══════════════════════════════════════════════════════════════
         TYPOGRAPHY
    ══════════════════════════════════════════════════════════════════ -->

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding
            Light={StaticResource OnSurfaceLight},
            Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding
                                Light={StaticResource DividerLight},
                                Dark={StaticResource DividerDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Label" x:Key="Headline">
        <Setter Property="TextColor" Value="{AppThemeBinding
            Light={StaticResource OnSurfaceLight},
            Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="SubHeadline">
        <Setter Property="TextColor" Value="{AppThemeBinding
            Light={StaticResource OnSurfaceMutedLight},
            Dark={StaticResource OnSurfaceMutedDark}}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="PageTitle">
        <Setter Property="TextColor" Value="{AppThemeBinding
            Light={StaticResource OnSurfaceLight},
            Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="Muted">
        <Setter Property="TextColor" Value="{AppThemeBinding
            Light={StaticResource OnSurfaceMutedLight},
            Dark={StaticResource OnSurfaceMutedDark}}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ══════════════════════════════════════════════════════════════
         CONTROLS
    ══════════════════════════════════════════════════════════════════ -->

    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding
            Light={StaticResource BrandPurple},
            Dark={StaticResource BrandPurpleLight}}" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding
                                Light={StaticResource OnSurfaceMutedLight},
                                Dark={StaticResource OnSurfaceMutedDark}}" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding
                                Light={StaticResource DividerLight},
                                Dark={StaticResource DividerDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding
            Light={StaticResource DividerLight},
            Dark={StaticResource DividerDark}}" />
        <Setter Property="StrokeShape" Value="Rectangle"/>
        <Setter Property="StrokeThickness" Value="1"/>
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{AppThemeBinding
            Light={StaticResource OnSurfaceLight},
            Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding
            Light={StaticResource OnSurfaceMutedLight},
            Dark={StaticResource OnSurfaceMutedDark}}" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding
            Light={StaticResource BrandPurple},
            Dark={StaticResource BrandPurpleLight}}" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{AppThemeBinding
            Light={StaticResource BrandPurple},
            Dark={StaticResource BrandPurpleLight}}" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{AppThemeBinding
            Light={StaticResource BrandPurple},
            Dark={StaticResource BrandPurpleLight}}" />
        <Setter Property="ThumbColor" Value="{StaticResource White}" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{AppThemeBinding
            Light={StaticResource BrandPurple},
            Dark={StaticResource BrandPurpleLight}}" />
        <Setter Property="MaximumTrackColor" Value="{AppThemeBinding
            Light={StaticResource DividerLight},
            Dark={StaticResource DividerDark}}" />
        <Setter Property="ThumbColor" Value="{AppThemeBinding
            Light={StaticResource BrandPurple},
            Dark={StaticResource BrandPurpleLight}}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{AppThemeBinding
            Light={StaticResource BrandPurple},
            Dark={StaticResource BrandPurpleLight}}" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{AppThemeBinding
            Light={StaticResource BrandPurple},
            Dark={StaticResource BrandPurpleLight}}" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{AppThemeBinding
            Light={StaticResource OnSurfaceLight},
            Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding
            Light={StaticResource OnSurfaceMutedLight},
            Dark={StaticResource OnSurfaceMutedDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{AppThemeBinding
            Light={StaticResource OnSurfaceLight},
            Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{AppThemeBinding
            Light={StaticResource OnSurfaceLight},
            Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="TextColor" Value="{AppThemeBinding
            Light={StaticResource OnSurfaceLight},
            Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{AppThemeBinding
            Light={StaticResource OnSurfaceLight},
            Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding
            Light={StaticResource OnSurfaceMutedLight},
            Dark={StaticResource OnSurfaceMutedDark}}" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
    </Style>

    <Style TargetType="SwipeItem">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding
            Light={StaticResource SurfaceLight},
            Dark={StaticResource SurfaceDark}}" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding
            Light={StaticResource DividerLight},
            Dark={StaticResource DividerDark}}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding
            Light={StaticResource SurfaceLight},
            Dark={StaticResource SurfaceDark}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding
            Light={StaticResource OnSurfaceLight},
            Dark={StaticResource OnSurfaceDark}}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding
            Light={StaticResource TabBarBgLight},
            Dark={StaticResource TabBarBgDark}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding
            Light={StaticResource TabBarSelectedLight},
            Dark={StaticResource TabBarSelectedDark}}" />
        <Setter Property="UnselectedTabColor" Value="{AppThemeBinding
            Light={StaticResource TabBarUnselectedLight},
            Dark={StaticResource TabBarUnselectedDark}}" />
        <Setter Property="SelectedTabColor" Value="{AppThemeBinding
            Light={StaticResource TabBarSelectedLight},
            Dark={StaticResource TabBarSelectedDark}}" />
    </Style>

    <Style TargetType="ImageButton">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="BorderColor" Value="Transparent"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{AppThemeBinding
            Light={StaticResource OnSurfaceLight},
            Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
    </Style>

    <Style TargetType="IndicatorView">
        <Setter Property="IndicatorColor" Value="{AppThemeBinding
            Light={StaticResource DividerLight},
            Dark={StaticResource DividerDark}}"/>
        <Setter Property="SelectedIndicatorColor" Value="{AppThemeBinding
            Light={StaticResource BrandPurple},
            Dark={StaticResource BrandPurpleLight}}"/>
    </Style>

    <Style TargetType="Shadow">
        <Setter Property="Radius" Value="12" />
        <Setter Property="Opacity" Value="0.18" />
        <Setter Property="Brush" Value="{AppThemeBinding
            Light={StaticResource BlackBrush},
            Dark={StaticResource BlackBrush}}" />
        <Setter Property="Offset" Value="0,4" />
    </Style>

    <!-- Custom top nav button for desktop -->
    <Style x:Key="TopNavButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceMutedLight}, Dark={StaticResource OnSurfaceMutedDark}}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="MinimumWidthRequest" Value="80" />
    </Style>

    <Style TargetType="SearchHandler">
        <Setter Property="TextColor" Value="{AppThemeBinding
            Light={StaticResource OnSurfaceLight},
            Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding
            Light={StaticResource OnSurfaceMutedLight},
            Dark={StaticResource OnSurfaceMutedDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

</ResourceDictionary>
