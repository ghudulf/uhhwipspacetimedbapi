<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ── Brand ──────────────────────────────────────────────────── -->
    <Color x:Key="BrandPurple">#6C63FF</Color>
    <Color x:Key="BrandPurpleLight">#8B85FF</Color>
    <Color x:Key="BrandPurpleDark">#4A44CC</Color>
    <Color x:Key="BrandAccentBlue">#4FC3F7</Color>
    <Color x:Key="BrandAccentGreen">#66BB6A</Color>
    <Color x:Key="BrandAccentRed">#EF5350</Color>

    <!-- ── Semantic (light) ───────────────────────────────────────── -->
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceVariantLight">#F4F3FF</Color>
    <Color x:Key="SurfaceCardLight">#EEEDF9</Color>
    <Color x:Key="BackgroundLight">#F0EFF8</Color>
    <Color x:Key="OnSurfaceLight">#1A1A2E</Color>
    <Color x:Key="OnSurfaceMutedLight">#6B6880</Color>
    <Color x:Key="DividerLight">#D8D6EE</Color>
    <Color x:Key="StatusBarAccentLight">#7C7CFF</Color>

    <!-- ── Semantic (dark) ────────────────────────────────────────── -->
    <Color x:Key="SurfaceDark">#1E1E2E</Color>
    <Color x:Key="SurfaceVariantDark">#2A2A42</Color>
    <Color x:Key="SurfaceCardDark">#252540</Color>
    <Color x:Key="BackgroundDark">#16161E</Color>
    <Color x:Key="OnSurfaceDark">#E8E6FF</Color>
    <Color x:Key="OnSurfaceMutedDark">#8080A0</Color>
    <Color x:Key="DividerDark">#3A3A5C</Color>
    <Color x:Key="StatusBarAccentDark">#7C7CFF</Color>

    <!-- ── TabBar (light) ─────────────────────────────────────────── -->
    <Color x:Key="TabBarBgLight">#FFFFFF</Color>
    <Color x:Key="TabBarSelectedLight">#6C63FF</Color>
    <Color x:Key="TabBarUnselectedLight">#9E9BB8</Color>

    <!-- ── TabBar (dark) ──────────────────────────────────────────── -->
    <Color x:Key="TabBarBgDark">#1A1A28</Color>
    <Color x:Key="TabBarSelectedDark">#8B85FF</Color>
    <Color x:Key="TabBarUnselectedDark">#5A5870</Color>

    <!-- ── Legacy aliases (keep existing code compiling) ─────────── -->
    <Color x:Key="Primary">#6C63FF</Color>
    <Color x:Key="PrimaryDark">#8B85FF</Color>
    <Color x:Key="PrimaryDarkText">#1A1A2E</Color>
    <Color x:Key="Secondary">#E8E6FF</Color>
    <Color x:Key="SecondaryDarkText">#8B85FF</Color>
    <Color x:Key="Tertiary">#4A44CC</Color>
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#6C63FF</Color>
    <Color x:Key="MidnightBlue">#1A1A2E</Color>
    <Color x:Key="OffBlack">#1E1E2E</Color>
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- ── Brushes ────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="PrimaryBrush"    Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush"  Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush"   Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush"      Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush"      Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="Gray100Brush"    Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush"    Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush"    Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush"    Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush"    Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush"    Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush"    Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush"    Color="{StaticResource Gray950}"/>

</ResourceDictionary>
