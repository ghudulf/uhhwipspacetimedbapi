<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
  <!-- AVALONIA BACKEND FOR MAUI REQUIRES NET 11 MINIMUM-->
    <!-- EnableMobileTargets: set to true in local dev environments with mobile SDKs installed; CI sets to false -->
    <EnableMobileTargets Condition="'$(EnableMobileTargets)' == ''">false</EnableMobileTargets>
    <TargetFrameworks Condition="'$(EnableMobileTargets)' == 'true'">net11.0-android;net11.0-ios;net11.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(EnableMobileTargets)' != 'true'">net11.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Display name -->
    <ApplicationTitle>BRU Avtopark</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.bru.avtopark.ticketsales</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- DESKTOP constant for platform guards in shared Unity library -->
    <!-- MAUI_HOST constant to distinguish MAUI-hosted desktop from standalone desktop -->
    <DefineConstants Condition="'$(TargetFramework)' == 'net11.0'">$(DefineConstants);DESKTOP;MAUI_HOST</DefineConstants>

    <!-- Windows application manifest: declares Win10/11 support so NativeControlHost
         (used by NativeWebView/WebView2) can create child HWNDs without crashing. -->
    <ApplicationManifest Condition="'$(TargetFramework)' == 'net11.0'">app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Android-specific properties -->
  <PropertyGroup Condition="$(TargetFramework.StartsWith('net10.0-android'))">
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>21.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <!-- iOS-specific properties -->
  <PropertyGroup Condition="$(TargetFramework.StartsWith('net10.0-ios'))">
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- App icon (standard MAUI template resource) -->
    <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/appiconfg.svg" Color="#512BD4"/>

    <!-- Splash screen -->
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#512BD4" BaseSize="128,128"/>

    <!-- Images -->
    <MauiImage Include="Resources/Images/*"/>

    <!-- Fonts -->
    <MauiFont Include="Resources/Fonts/*"/>

    <!-- Raw assets -->
    <MauiAsset Include="Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)"/>
  </ItemGroup>

  <PropertyGroup>
    <!-- MAUI version property -->
    <MauiVersion>11.0.0-preview.2.26152.10 </MauiVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <!-- Serilog: structured logging with file + debug sinks -->
    <PackageReference Include="Serilog" Version="4.2.1-dev-02337" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <!-- Avalonia core - explicit reference so Avalonia.Controls types resolve in this project -->
    <PackageReference Include="Avalonia" Version="12.0.0-preview2" />
    <!-- Avalonia.Controls.Maui - replaces MAUI rendering pipeline with Avalonia/Skia -->
    <PackageReference Include="Avalonia.Controls.Maui" Version="11.0.0-preview.2.26075.1512" />
    <!-- Desktop package: provides source-generated AppBuilder + run loop for net11.0 generic desktop TFM -->
    <PackageReference Include="Avalonia.Controls.Maui.Desktop"
                      Condition="'$(TargetFramework)' == 'net11.0'"
                      Version="11.0.0-preview.2.26075.1512" />
    <!-- Optional: Essentials API support (FilePicker, Screenshot, etc.) -->
    <PackageReference Include="Avalonia.Controls.Maui.Essentials" Version="11.0.0-preview.2.26075.1512" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the shared Avalonia Unity library -->
    <ProjectReference Include="..\BRU.Avtopark.TicketSalesAPP.Avalonia.Unity\BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.csproj"/>
  </ItemGroup>

</Project>