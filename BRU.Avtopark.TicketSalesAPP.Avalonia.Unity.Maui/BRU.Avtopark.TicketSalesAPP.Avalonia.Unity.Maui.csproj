<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- EnableMobileTargets: set to true in local dev environments with mobile SDKs installed; CI sets to false -->
    <EnableMobileTargets Condition="'$(EnableMobileTargets)' == ''">false</EnableMobileTargets>
    <TargetFrameworks Condition="'$(EnableMobileTargets)' == 'true'">net10.0-android;net10.0-ios;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(EnableMobileTargets)' != 'true'">net10.0</TargetFrameworks>
    <RootNamespace>BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Display name -->
    <ApplicationTitle>BRU Avtopark</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.bru.avtopark.ticketsales</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- DESKTOP constant for platform guards in shared Unity library -->
    <!-- MAUI_HOST constant to distinguish MAUI-hosted desktop from standalone desktop -->
    <DefineConstants Condition="'$(TargetFramework)' == 'net10.0'">$(DefineConstants);DESKTOP;MAUI_HOST</DefineConstants>
  </PropertyGroup>

  <!-- Android-specific properties -->
  <PropertyGroup Condition="$(TargetFramework.StartsWith('net10.0-android'))">
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>21.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <!-- iOS-specific properties -->
  <PropertyGroup Condition="$(TargetFramework.StartsWith('net10.0-ios'))">
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- App icon (standard MAUI template resource) -->
    <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/appiconfg.svg" Color="#512BD4"/>

    <!-- Splash screen -->
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#512BD4" BaseSize="128,128"/>

    <!-- Images -->
    <MauiImage Include="Resources/Images/*"/>

    <!-- Fonts -->
    <MauiFont Include="Resources/Fonts/*"/>

    <!-- Raw assets -->
    <MauiAsset Include="Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)"/>
  </ItemGroup>

  <PropertyGroup>
    <!-- MAUI version property -->
    <MauiVersion>10.0.0</MauiVersion>
  </PropertyGroup>

  <ItemGroup>
  <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <!-- Avalonia.Controls.Maui - WHILE IT USES AVALONIA 12 - ITS VERSION FOR SOME REASON IS SET AS 11.0 - NOT A ISSUE - THATS THE ONLY NUGET VERSION AVAILABLE RELEASED 2 DAYS AGO: replaces MAUI rendering pipeline with Avalonia/Skia -->
    <PackageReference Include="Avalonia.Controls.Maui" Version="11.0.0-preview.2.26075.1512" />
    <!-- Optional: Essentials API support (FilePicker, Screenshot, etc.) -->
    <PackageReference Include="Avalonia.Controls.Maui.Essentials" Version="11.0.0-preview.2.26075.1512" />

  </ItemGroup>

  <ItemGroup>
    <!-- Reference the shared Avalonia Unity library -->
    <ProjectReference Include="..\BRU.Avtopark.TicketSalesAPP.Avalonia.Unity\BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.csproj"/>
  </ItemGroup>

</Project>