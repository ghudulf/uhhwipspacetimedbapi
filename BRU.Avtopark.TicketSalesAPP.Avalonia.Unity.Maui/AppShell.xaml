<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Maui.Pages"
    Title="BRU Avtopark"
    Shell.NavBarIsVisible="False">

    <!--
        Shell.TabBarIsVisible is controlled from code-behind:
          - False during unauthenticated flow (splash / login pages)
          - True once the user reaches //main (authenticated TabBar)

        Unauthenticated routes live outside the TabBar so they never show tabs.
        Authenticated routes live inside a TabBar that is enabled on navigation.
    -->

    <!-- ── Unauthenticated flow ─────────────────────────────────────── -->

    <ShellContent
        Route="splash"
        ContentTemplate="{DataTemplate pages:SplashPage}"
        Shell.NavBarIsVisible="False"
        Shell.TabBarIsVisible="False" />

    <ShellContent
        Route="login"
        ContentTemplate="{DataTemplate pages:LoginSelectorPage}"
        Shell.NavBarIsVisible="False"
        Shell.TabBarIsVisible="False" />

    <ShellContent
        Route="oauth-login"
        ContentTemplate="{DataTemplate pages:OAuthLoginPage}"
        Shell.NavBarIsVisible="False"
        Shell.TabBarIsVisible="False" />

    <ShellContent
        Route="traditional-login"
        ContentTemplate="{DataTemplate pages:TraditionalLoginPage}"
        Shell.NavBarIsVisible="False"
        Shell.TabBarIsVisible="False" />

    <!-- ── Authenticated TabBar ─────────────────────────────────────── -->

    <TabBar x:Name="MainTabBar" Route="main" Shell.NavBarIsVisible="False">

        <Tab Title="Главная" Route="dashboard">
            <ShellContent
                Route="dashboard"
                ContentTemplate="{DataTemplate pages:MainContentPage}"
                Shell.NavBarIsVisible="False" />
        </Tab>

        <Tab Title="Маршруты" Route="routes">
            <ShellContent
                Route="routes"
                ContentTemplate="{DataTemplate pages:RoutesPage}"
                Shell.NavBarIsVisible="False" />
        </Tab>

        <Tab Title="Билеты" Route="tickets">
            <ShellContent
                Route="tickets"
                ContentTemplate="{DataTemplate pages:TicketsPage}"
                Shell.NavBarIsVisible="False" />
        </Tab>

        <Tab Title="Профиль" Route="profile">
            <ShellContent
                Route="profile"
                ContentTemplate="{DataTemplate pages:ProfilePage}"
                Shell.NavBarIsVisible="False" />
        </Tab>

    </TabBar>

</Shell>
