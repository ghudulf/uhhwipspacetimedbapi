<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Maui.Pages"
    Title="BRU Avtopark">

    <!--
        Unauthenticated flow:
          //splash  → SplashPage  (checks token, routes to //login or //main)
          //login   → LoginSelectorPage  (OAuth vs Traditional)
          oauth-login        → OAuthLoginPage        (Avalonia OAuthLoginControl via AvaloniaView)
          traditional-login  → TraditionalLoginPage  (Avalonia TraditionalLoginControl via AvaloniaView)

        Authenticated flow:
          //main   → MainContentPage
    -->

    <!-- Splash — initial route -->
    <ShellContent
        Route="splash"
        ContentTemplate="{DataTemplate pages:SplashPage}"
        Shell.NavBarIsVisible="False" />

    <!-- Login selector -->
    <ShellContent
        Route="login"
        ContentTemplate="{DataTemplate pages:LoginSelectorPage}"
        Shell.NavBarIsVisible="False" />

    <!-- OAuth login (Avalonia WebView embedded) -->
    <ShellContent
        Route="oauth-login"
        ContentTemplate="{DataTemplate pages:OAuthLoginPage}"
        Shell.NavBarIsVisible="False" />

    <!-- Traditional login (Avalonia wizard embedded) -->
    <ShellContent
        Route="traditional-login"
        ContentTemplate="{DataTemplate pages:TraditionalLoginPage}"
        Shell.NavBarIsVisible="False" />

    <!-- Main authenticated content -->
    <ShellContent
        Route="main"
        ContentTemplate="{DataTemplate pages:MainContentPage}"
        Shell.NavBarIsVisible="False" />

</Shell>
