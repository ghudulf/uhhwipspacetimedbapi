<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Maui.Pages.OAuthLoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maui="clr-namespace:Avalonia.Controls.Maui.Controls;assembly=Avalonia.Controls.Maui"
    xmlns:controls="clr-namespace:BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Controls;assembly=BRU.Avtopark.TicketSalesAPP.Avalonia.Unity"
    BackgroundColor="#1E1E2E"
    Shell.NavBarIsVisible="False">

    <!-- Outer Grid: rows for header / content / footer -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="12,10" BackgroundColor="#2D2D44">
            <Button Grid.Column="0"
                    Text="← Назад"
                    BackgroundColor="Transparent"
                    TextColor="#A0A0B0"
                    FontSize="14"
                    Padding="0"
                    Clicked="OnBackClicked" />
            <Label Grid.Column="1"
                   Text="OAuth авторизация"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Grid>

        <!--
            Content area: AvaloniaView + loading overlay stacked in the same cell.
            The overlay sits on top (declared last) and is hidden by default.
        -->
        <Grid Grid.Row="1">

            <!-- Avalonia OAuthLoginControl embedded via AvaloniaView -->
            <maui:AvaloniaView
                x:Name="OAuthAvaloniaView"
                HorizontalOptions="Fill"
                VerticalOptions="Fill">
                <controls:OAuthLoginControl
                    x:Name="OAuthControl" />
            </maui:AvaloniaView>

            <!--
                Loading overlay — shown as soon as the auth code is received.
                Covers the WebView so the user never sees the "navigation failed"
                error that appears when the callback URL is intercepted.
            -->
            <Grid x:Name="LoadingOverlay"
                  IsVisible="False"
                  HorizontalOptions="Fill"
                  VerticalOptions="Fill">

                <!-- Semi-transparent dark backdrop -->
                <BoxView Color="#CC1E1E2E"
                         HorizontalOptions="Fill"
                         VerticalOptions="Fill" />

                <!-- Centred spinner + label -->
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="20">

                    <ActivityIndicator
                        IsRunning="True"
                        Color="#7C7CFF"
                        WidthRequest="48"
                        HeightRequest="48"
                        HorizontalOptions="Center" />

                    <Label Text="Выполняется авторизация..."
                           TextColor="White"
                           FontSize="16"
                           HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Grid>

        </Grid>

        <!-- Error / status footer -->
        <Label x:Name="ErrorLabel"
               Grid.Row="2"
               Text=""
               TextColor="#FF6B6B"
               FontSize="13"
               HorizontalOptions="Center"
               Margin="16,8"
               IsVisible="False" />
    </Grid>
</ContentPage>
