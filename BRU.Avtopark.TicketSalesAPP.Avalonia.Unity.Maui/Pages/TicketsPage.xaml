<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Maui.Pages.TicketsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#1E1E2E"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" Padding="20,16" BackgroundColor="#2D2D44">
            <Label Text="Билеты"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center" />
        </Grid>

        <VerticalStackLayout Grid.Row="1"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="12">
            <Label Text="🎫"
                   FontSize="48"
                   HorizontalOptions="Center" />
            <Label Text="Билеты"
                   FontSize="18"
                   TextColor="#A0A0B0"
                   HorizontalOptions="Center" />
            <Label Text="Продажа и история билетов будет здесь"
                   FontSize="13"
                   TextColor="#606070"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
