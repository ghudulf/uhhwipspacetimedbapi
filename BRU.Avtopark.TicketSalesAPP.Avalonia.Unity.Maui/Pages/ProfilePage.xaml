<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Maui.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#1E1E2E"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" Padding="20,16" BackgroundColor="#2D2D44">
            <Label Text="Профиль"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center" />
        </Grid>

        <VerticalStackLayout Grid.Row="1"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="12">
            <Label Text="👤"
                   FontSize="48"
                   HorizontalOptions="Center" />
            <Label Text="Профиль пользователя"
                   FontSize="18"
                   TextColor="#A0A0B0"
                   HorizontalOptions="Center" />
            <Button Text="Выйти"
                    BackgroundColor="#3D3D5C"
                    TextColor="#FF6B6B"
                    CornerRadius="12"
                    Padding="32,12"
                    Clicked="OnLogoutClicked" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
