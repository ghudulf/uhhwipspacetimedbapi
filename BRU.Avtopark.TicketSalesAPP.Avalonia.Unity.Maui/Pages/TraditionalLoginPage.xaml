<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Maui.Pages.TraditionalLoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maui="clr-namespace:Avalonia.Controls.Maui.Controls;assembly=Avalonia.Controls.Maui"
    xmlns:controls="clr-namespace:BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Controls;assembly=BRU.Avtopark.TicketSalesAPP.Avalonia.Unity"
    BackgroundColor="{AppThemeBinding Light={StaticResource AuthBgLight}, Dark={StaticResource AuthBgDark}}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="12,10"
              BackgroundColor="{AppThemeBinding Light={StaticResource AuthHeaderLight}, Dark={StaticResource AuthHeaderDark}}">
            <Button Grid.Column="0"
                    Text="← Назад"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource OnSurfaceMutedLight}, Dark={StaticResource OnSurfaceMutedDark}}"
                    FontSize="14"
                    Padding="0"
                    Clicked="OnBackClicked" />
            <Label Grid.Column="1"
                   Text="Вход с паролем"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Grid>

        <maui:AvaloniaView
            x:Name="TraditionalAvaloniaView"
            Grid.Row="1"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">
            <controls:TraditionalLoginControl
                x:Name="TraditionalControl"
                AuthCompleted="OnAvaloniaAuthCompleted" />
        </maui:AvaloniaView>

        <!-- Error footer -->
        <Label x:Name="ErrorLabel"
               Grid.Row="2"
               Text=""
               TextColor="{StaticResource BrandAccentRed}"
               FontSize="13"
               HorizontalOptions="Center"
               Margin="16,8"
               IsVisible="False" />
    </Grid>
</ContentPage>
