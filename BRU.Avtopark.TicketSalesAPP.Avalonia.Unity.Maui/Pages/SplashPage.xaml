<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Maui.Pages.SplashPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#1E1E2E"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto,*">
        <VerticalStackLayout
            Grid.Row="1"
            HorizontalOptions="Center"
            Spacing="24">

            <!-- App icon placeholder -->
            <Frame
                BackgroundColor="#512BD4"
                CornerRadius="24"
                HeightRequest="96"
                WidthRequest="96"
                HorizontalOptions="Center"
                Padding="0">
                <Label
                    Text="🚌"
                    FontSize="48"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Frame>

            <Label
                Text="BRU Avtopark"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalOptions="Center" />

            <Label
                x:Name="StatusLabel"
                Text="Загрузка..."
                FontSize="14"
                TextColor="#A0A0B0"
                HorizontalOptions="Center" />

            <ActivityIndicator
                x:Name="Spinner"
                IsRunning="True"
                Color="#512BD4"
                HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
