<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Maui.Pages.MainContentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:nav="clr-namespace:BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Maui.Controls"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <nav:DesktopTopNav Grid.Row="0" ActiveRoute="dashboard" />

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="0" Padding="32,24,32,32">

                <!-- ── Page header ──────────────────────────────────── -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24">
                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                        <Label Text="Добро пожаловать"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#9090B0, Dark=#6060A0}" />
                        <Label x:Name="WelcomeLabel"
                               Text="BRU Авторпарк"
                               FontSize="26"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1E1A3C, Dark=#E8E4FF}" />
                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            BackgroundColor="{AppThemeBinding Light=#EAE8FF, Dark=#2A2A42}"
                            StrokeShape="RoundRectangle 22"
                            StrokeThickness="0"
                            WidthRequest="44" HeightRequest="44"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProfileTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="👤" FontSize="18"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- ── Stat cards ────────────────────────────────────── -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16" Margin="0,0,0,24">

                    <!-- Routes -->
                    <Border StrokeShape="RoundRectangle 14"
                            StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C2E}"
                            Padding="20,18">
                        <Border.Stroke>
                            <AppThemeBinding Light="#E8E6F8" Dark="#2E2E48" />
                        </Border.Stroke>
                        <Border.Shadow>
                            <Shadow Brush="#20000000" Offset="0,2" Radius="8" Opacity="0.12" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="🗺️" FontSize="22" />
                            <Label x:Name="RoutesCountLabel"
                                   Text="—"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#1E1A3C, Dark=#E8E4FF}" />
                            <Label Text="Маршруты"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#9090B0, Dark=#6060A0}" />
                            <BoxView HeightRequest="3" CornerRadius="2"
                                     BackgroundColor="{StaticResource BrandPurple}"
                                     HorizontalOptions="Start" WidthRequest="32" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Buses -->
                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C2E}"
                            Padding="20,18">
                        <Border.Stroke>
                            <AppThemeBinding Light="#E8E6F8" Dark="#2E2E48" />
                        </Border.Stroke>
                        <Border.Shadow>
                            <Shadow Brush="#20000000" Offset="0,2" Radius="8" Opacity="0.12" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="🚌" FontSize="22" />
                            <Label x:Name="BusesCountLabel"
                                   Text="—"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#1E1A3C, Dark=#E8E4FF}" />
                            <Label Text="Автобусы"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#9090B0, Dark=#6060A0}" />
                            <BoxView HeightRequest="3" CornerRadius="2"
                                     BackgroundColor="{StaticResource BrandAccentBlue}"
                                     HorizontalOptions="Start" WidthRequest="32" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Today -->
                    <Border Grid.Column="2"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C2E}"
                            Padding="20,18">
                        <Border.Stroke>
                            <AppThemeBinding Light="#E8E6F8" Dark="#2E2E48" />
                        </Border.Stroke>
                        <Border.Shadow>
                            <Shadow Brush="#20000000" Offset="0,2" Radius="8" Opacity="0.12" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="🎫" FontSize="22" />
                            <Label x:Name="TicketsTodayLabel"
                                   Text="—"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#1E1A3C, Dark=#E8E4FF}" />
                            <Label Text="Билеты сегодня"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#9090B0, Dark=#6060A0}" />
                            <BoxView HeightRequest="3" CornerRadius="2"
                                     BackgroundColor="{StaticResource BrandAccentGreen}"
                                     HorizontalOptions="Start" WidthRequest="32" />
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <!-- ── Status banner ─────────────────────────────────── -->
                <Border StrokeShape="RoundRectangle 14"
                        StrokeThickness="1"
                        Margin="0,0,0,28"
                        Padding="20,16">
                    <Border.BackgroundColor>
                        <AppThemeBinding Light="#F0EEFF" Dark="#1A1A2E" />
                    </Border.BackgroundColor>
                    <Border.Stroke>
                        <AppThemeBinding Light="#D8D4FF" Dark="#2E2E50" />
                    </Border.Stroke>
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0"
                                BackgroundColor="{StaticResource BrandPurple}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 6"
                                WidthRequest="6"
                                Margin="0,0,14,0" />
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="Система активна"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#3D2FA0, Dark=#C0B8FF}" />
                            <Label x:Name="StatusLabel"
                                   Text="Подключение к серверу..."
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#7070A0, Dark=#6060A0}"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- ── Quick actions ─────────────────────────────────── -->
                <Label Text="Быстрые действия"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#1E1A3C, Dark=#C0BCFF}"
                       Margin="0,0,0,14" />

                <VerticalStackLayout Spacing="10">

                    <!-- Sell ticket -->
                    <Border StrokeShape="RoundRectangle 14"
                            StrokeThickness="1"
                            Padding="0">
                        <Border.BackgroundColor>
                            <AppThemeBinding Light="#FFFFFF" Dark="#1C1C2E" />
                        </Border.BackgroundColor>
                        <Border.Stroke>
                            <AppThemeBinding Light="#E8E6F8" Dark="#2E2E48" />
                        </Border.Stroke>
                        <Border.Shadow>
                            <Shadow Brush="#18000000" Offset="0,2" Radius="6" Opacity="0.1" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSellTicketTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="4,*,Auto" Padding="0,14,18,14">
                            <BoxView BackgroundColor="{StaticResource BrandAccentGreen}"
                                     VerticalOptions="Fill" Margin="0,6,0,6" />
                            <VerticalStackLayout Grid.Column="1" Spacing="3" Padding="16,0,0,0">
                                <Label Text="Продать билет"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1E1A3C, Dark=#E8E4FF}" />
                                <Label Text="Оформить новый билет на маршрут"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#9090B0, Dark=#6060A0}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›"
                                   FontSize="20"
                                   TextColor="{AppThemeBinding Light=#C0BCFF, Dark=#5050A0}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Routes -->
                    <Border StrokeShape="RoundRectangle 14"
                            StrokeThickness="1"
                            Padding="0">
                        <Border.BackgroundColor>
                            <AppThemeBinding Light="#FFFFFF" Dark="#1C1C2E" />
                        </Border.BackgroundColor>
                        <Border.Stroke>
                            <AppThemeBinding Light="#E8E6F8" Dark="#2E2E48" />
                        </Border.Stroke>
                        <Border.Shadow>
                            <Shadow Brush="#18000000" Offset="0,2" Radius="6" Opacity="0.1" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRoutesTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="4,*,Auto" Padding="0,14,18,14">
                            <BoxView BackgroundColor="{StaticResource BrandPurple}"
                                     VerticalOptions="Fill" Margin="0,6,0,6" />
                            <VerticalStackLayout Grid.Column="1" Spacing="3" Padding="16,0,0,0">
                                <Label Text="Маршруты"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1E1A3C, Dark=#E8E4FF}" />
                                <Label Text="Просмотр и управление маршрутами"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#9090B0, Dark=#6060A0}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›"
                                   FontSize="20"
                                   TextColor="{AppThemeBinding Light=#C0BCFF, Dark=#5050A0}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Schedule -->
                    <Border StrokeShape="RoundRectangle 14"
                            StrokeThickness="1"
                            Padding="0">
                        <Border.BackgroundColor>
                            <AppThemeBinding Light="#FFFFFF" Dark="#1C1C2E" />
                        </Border.BackgroundColor>
                        <Border.Stroke>
                            <AppThemeBinding Light="#E8E6F8" Dark="#2E2E48" />
                        </Border.Stroke>
                        <Border.Shadow>
                            <Shadow Brush="#18000000" Offset="0,2" Radius="6" Opacity="0.1" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnScheduleTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="4,*,Auto" Padding="0,14,18,14">
                            <BoxView BackgroundColor="{StaticResource BrandAccentBlue}"
                                     VerticalOptions="Fill" Margin="0,6,0,6" />
                            <VerticalStackLayout Grid.Column="1" Spacing="3" Padding="16,0,0,0">
                                <Label Text="Расписание"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1E1A3C, Dark=#E8E4FF}" />
                                <Label Text="Расписание рейсов на сегодня"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#9090B0, Dark=#6060A0}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›"
                                   FontSize="20"
                                   TextColor="{AppThemeBinding Light=#C0BCFF, Dark=#5050A0}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
