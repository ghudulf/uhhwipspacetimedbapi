<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.App"
             xmlns:local="using:BRU.Avtopark.TicketSalesAPP.Avalonia.Unity"
              xmlns:views="clr-namespace:BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Views"
			 xmlns:toolviews="clr-namespace:BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Views.ManagementToolWindowsViews"
			  
			xmlns:viewModels="clr-namespace:BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.ViewModels"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:converters="using:BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Converters"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <!-- ── Light theme ───────────────────────────────────────── -->
                <ResourceDictionary x:Key="Light">
                    <!-- Control chrome -->
                    <SolidColorBrush x:Key="BruHeaderBackground">#F0F0F0</SolidColorBrush>
                    <SolidColorBrush x:Key="BruHeaderBorder">#C0C0C0</SolidColorBrush>
                    <SolidColorBrush x:Key="BruFooterBackground">#E0E0E0</SolidColorBrush>
                    <SolidColorBrush x:Key="BruFooterBorder">#B0B0B0</SolidColorBrush>
                    <!-- Text -->
                    <SolidColorBrush x:Key="BruTitleForeground">#1A1A1A</SolidColorBrush>
                    <SolidColorBrush x:Key="BruSubtleForeground">#505050</SolidColorBrush>
                    <!-- Loading indicator -->
                    <SolidColorBrush x:Key="BruLoadingCircle">#0050C8</SolidColorBrush>
                    <!-- BRU Design System -->
                    <SolidColorBrush x:Key="BgElevated">#F5F5FA</SolidColorBrush>
                    <SolidColorBrush x:Key="TextFaint">#D0D0D8</SolidColorBrush>
                    <SolidColorBrush x:Key="TextMuted">#707080</SolidColorBrush>
                </ResourceDictionary>

                <!-- ── Dark theme ────────────────────────────────────────── -->
                <ResourceDictionary x:Key="Dark">
                    <!-- Control chrome -->
                    <SolidColorBrush x:Key="BruHeaderBackground">#252530</SolidColorBrush>
                    <SolidColorBrush x:Key="BruHeaderBorder">#3A3A48</SolidColorBrush>
                    <SolidColorBrush x:Key="BruFooterBackground">#1A1A24</SolidColorBrush>
                    <SolidColorBrush x:Key="BruFooterBorder">#3A3A48</SolidColorBrush>
                    <!-- Text -->
                    <SolidColorBrush x:Key="BruTitleForeground">#F0F0F0</SolidColorBrush>
                    <SolidColorBrush x:Key="BruSubtleForeground">#909090</SolidColorBrush>
                    <!-- Loading indicator -->
                    <SolidColorBrush x:Key="BruLoadingCircle">#4080FF</SolidColorBrush>
                    <!-- BRU Design System -->
                    <SolidColorBrush x:Key="BgElevated">#1E1E28</SolidColorBrush>
                    <SolidColorBrush x:Key="TextFaint">#3A3A48</SolidColorBrush>
                    <SolidColorBrush x:Key="TextMuted">#4A4A58</SolidColorBrush>
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>

            <!-- Converters (theme-neutral) -->
            <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <converters:BoolToConnectTextConverter x:Key="BoolToConnectTextConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <converters:StatusToBackgroundConverter x:Key="StatusToBackgroundConverter"/>
            <converters:StatusToBorderBrushConverter x:Key="StatusToBorderBrushConverter"/>
        </ResourceDictionary>
    </Application.Resources>

    
  
    <Application.Styles>
		<FluentTheme/>
		
         
          <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <materialIcons:MaterialIconStyles />
     </Application.Styles>

	<Application.DataTemplates>
		<DataTemplate x:DataType="viewModels:ExplorerViewModel">
			<views:Explorer />
		</DataTemplate>
		<DataTemplate x:DataType="viewModels:DebugViewModel">
			<views:Debug />
		</DataTemplate>
		<DataTemplate x:DataType="viewModels:NotificationsViewModel">
			<views:Notifications />
		</DataTemplate>
		<DataTemplate x:DataType="viewModels:ProblemViewModel">
			<views:Problem />
		</DataTemplate>
		<DataTemplate x:DataType="viewModels:PropertiesViewModel">
			<views:Properties />
		</DataTemplate>
		<DataTemplate x:DataType="viewModels:SearchViewModel">
			<views:Search />
		</DataTemplate>
		<DataTemplate x:DataType="viewModels:BusManagementViewModel">
			<views:BusManagementToolWindow />
		</DataTemplate>
		<DataTemplate x:DataType="viewModels:EmployeeManagementViewModel">
			<toolviews:EmployeeManagementToolWindow />
		</DataTemplate>
		<DataTemplate x:DataType="viewModels:JobManagementViewModel">
			<toolviews:JobManagementToolWindow />
		</DataTemplate>
		<DataTemplate x:DataType="viewModels:MaintenanceManagementViewModel">
			<toolviews:MaintenanceManagementToolWindow />
		</DataTemplate>
		<DataTemplate x:DataType="viewModels:RouteManagementViewModel">
			<views:RouteManagementToolWindow />
		</DataTemplate>
		<DataTemplate x:DataType="viewModels:SalesManagementViewModel">
			<views:SalesManagementToolWindow />
		</DataTemplate>
		<DataTemplate x:DataType="viewModels:SalesStatisticsViewModel">
			<toolviews:SalesStatisticsToolWindow />
		</DataTemplate>
		<DataTemplate x:DataType="viewModels:TicketManagementViewModel">
			<views:TicketManagementToolWindow />
		</DataTemplate>
		<DataTemplate x:DataType="viewModels:UserManagementViewModel">
			<toolviews:UserManagementToolWindow />
		</DataTemplate>
		<DataTemplate x:DataType="viewModels:IncomeReportViewModel">
			<toolviews:IncomeReportToolWindow />
		</DataTemplate>
		<DataTemplate x:DataType="viewModels:RouteSchedulesManagementViewModel">
			<toolviews:RouteSchedulesManagementToolWindow />
		</DataTemplate>
	</Application.DataTemplates>


</Application>