<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Views.RouteManagementToolWindow"
             x:DataType="vm:RouteManagementViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="10">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBox Grid.Column="0" 
                     Text="{Binding SearchText}"
                     PlaceholderText="Поиск по начальной точке, конечной точке, модели автобуса или водителю..."
                     Margin="0,0,10,0"/>
            <Button Grid.Column="1" 
                    Command="{Binding AddCommand}"
                    Content="Добавить маршрут"
                    IsEnabled="{Binding !IsBusy}"/>
        </Grid>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Routes}"
                  SelectedItem="{Binding SelectedRoute}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="All"
                  BorderThickness="1"
                  BorderBrush="Gray"
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" 
                                  Binding="{ReflectionBinding RouteId}"
                                  Width="Auto"/>
                <DataGridTextColumn Header="Номер" 
                                  Binding="{ReflectionBinding RouteNumber}"
                                  Width="Auto"/>
                <DataGridTextColumn Header="Начальная точка" 
                                  Binding="{ReflectionBinding StartPoint}"
                                  Width="*"/>
                <DataGridTextColumn Header="Конечная точка" 
                                  Binding="{ReflectionBinding EndPoint}"
                                  Width="*"/>
                <DataGridTextColumn Header="Время в пути" 
                                  Binding="{ReflectionBinding TravelTime}"
                                  Width="Auto"/>
                <DataGridTextColumn Header="Автобус" 
                                  Binding="{ReflectionBinding BusModel}"
                                  Width="*"/>
                <DataGridTextColumn Header="Водитель" 
                                  Binding="{ReflectionBinding DriverName}"
                                  Width="*"/>
                <DataGridTextColumn Header="Билеты" 
                                  Binding="{ReflectionBinding TicketCount}"
                                  Width="Auto"/>
                <DataGridTextColumn Header="Остановки" 
                                  Binding="{ReflectionBinding StopCount}"
                                  Width="Auto"/>
                <DataGridTextColumn Header="Длина (км)" 
                                  Binding="{ReflectionBinding RouteLengthDisplay}"
                                  Width="Auto"/>
                <DataGridTextColumn Header="Тип" 
                                  Binding="{ReflectionBinding RouteType}"
                                  Width="Auto"/>
                <DataGridCheckBoxColumn Header="Активен" 
                                  Binding="{ReflectionBinding IsActive}"
                                  Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto">
            <TextBlock Grid.Column="0" 
                       Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       IsVisible="{Binding HasError}"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" 
                    Command="{Binding EditCommand}"
                    Content="Редактировать"
                    IsEnabled="{Binding SelectedRoute, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Margin="0,0,10,0"/>
            <Button Grid.Column="2" 
                    Command="{Binding DeleteCommand}"
                    Content="Удалить"
                    IsEnabled="{Binding SelectedRoute, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        </Grid>
    </Grid>
</UserControl>