    <UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:vm="using:BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.ViewModels"
            xmlns:icons="using:Material.Icons.Avalonia"
            x:DataType="vm:IncomeReportViewModel"
            mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
            x:Class="BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Views.ManagementToolWindowsViews.IncomeReportToolWindow">

        <Grid RowDefinitions="Auto,*" Margin="20">
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="15">
                    <!-- Title and Date Range -->
                    <Grid ColumnDefinitions="*,Auto" MinHeight="90">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Отчет по доходам" Theme="{StaticResource HeaderText}"/>
                            <TextBlock Text="Анализ продаж и доходов по периодам" Foreground="{DynamicResource SecondaryColor}"/>
                        </StackPanel>
                        
                        
                    </Grid>

                    <!-- Summary Cards -->
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="5">
                            <DatePicker SelectedDate="{Binding StartDate}" />
                            <TextBlock Text="-" VerticalAlignment="Center"/>
                            <DatePicker SelectedDate="{Binding EndDate}" />
                        </StackPanel>
                        <!-- Total Income Card -->
                        <Border Theme="{StaticResource ModernCard}" Margin="5" MinWidth="200" MaxWidth="500">
                            <Grid RowDefinitions="Auto,*">
                                
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <icons:MaterialIcon Kind="CurrencyRub" Width="24" Height="24" 
                                                    Foreground="{DynamicResource PrimaryColor}"/>
                                    <TextBlock Text="Общий доход" FontWeight="SemiBold"
                                            TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding TotalIncome, StringFormat={}{0:C}}" 
                                        FontSize="{DynamicResource FontSizeLarge}" FontWeight="Bold"
                                        TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Tickets Sold Card -->
                        <Border Theme="{StaticResource ModernCard}" Margin="5" MinWidth="300" MaxWidth="400">
                            <Grid RowDefinitions="Auto,*">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <icons:MaterialIcon Kind="Ticket" Width="24" Height="24" 
                                                    Foreground="{DynamicResource InfoColor}"/>
                                    <TextBlock Text="Продано билетов" FontWeight="SemiBold"
                                            TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding TotalTicketsSold}" 
                                        FontSize="{DynamicResource FontSizeLarge}" FontWeight="Bold"
                                        TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Average Price Card -->
                        <Border Theme="{StaticResource ModernCard}" Margin="5" MinWidth="300" MaxWidth="400">
                            <Grid RowDefinitions="Auto,*">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <icons:MaterialIcon Kind="ChartLineVariant" Width="24" Height="24" 
                                                    Foreground="{DynamicResource WarningColor}"/>
                                    <TextBlock Text="Средняя цена" FontWeight="SemiBold"
                                            TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding AverageTicketPrice, StringFormat={}{0:C}}" 
                                        FontSize="{DynamicResource FontSizeLarge}" FontWeight="Bold"
                                        TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </Grid>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        
            <!-- Content Section -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="20">
                    <!-- Charts Section -->
                    <WrapPanel Orientation="Horizontal">
                        <!-- Monthly Sales Chart — LiveCharts incompatible with Avalonia 12 preview2 -->
                        <Border Theme="{StaticResource ModernCard}" Margin="5" MinWidth="400" MaxWidth="800">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Динамика продаж" Theme="{StaticResource SubHeaderText}" TextWrapping="Wrap"/>
                                <Border Background="{DynamicResource BgElevated}" CornerRadius="8" Padding="16" MinHeight="250">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                        <icons:MaterialIcon Kind="ChartLine" Width="48" Height="48" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="График недоступен" FontSize="14" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="LiveCharts несовместим с Avalonia 12 preview2" FontSize="11" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Route Distribution Chart — same issue -->
                        <Border Theme="{StaticResource ModernCard}" Margin="5" MinWidth="400" MaxWidth="800">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Распределение по маршрутам" Theme="{StaticResource SubHeaderText}" TextWrapping="Wrap"/>
                                <Border Background="{DynamicResource BorderSubtle}" CornerRadius="8" Padding="16" MinHeight="250">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                        <icons:MaterialIcon Kind="ChartPie" Width="48" Height="48" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="График недоступен" FontSize="14" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="LiveCharts несовместим с Avalonia 12 preview2" FontSize="11" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
        
                    <!-- Data Tables Section -->
                    <WrapPanel Orientation="Horizontal">
                        <!-- Monthly Income Table -->
                        <Border Theme="{StaticResource ModernCard}" Margin="5" MinWidth="400" MaxWidth="800">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Text="Доход по месяцам" Theme="{StaticResource SubHeaderText}" TextWrapping="Wrap"/>
                                <DataGrid Grid.Row="1" 
                                        ItemsSource="{Binding MonthlyIncomes}"
                                        AutoGenerateColumns="False"
                                        IsReadOnly="True"
                                        MinHeight="200"
                                        MaxHeight="400"
                                        HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Месяц" Binding="{ReflectionBinding Month}"/>
                                        <DataGridTextColumn Header="Год" Binding="{ReflectionBinding Year}"/>
                                        <DataGridTextColumn Header="Доход" Binding="{ReflectionBinding TotalIncome, StringFormat={}{0:C}}"/>
                                        <DataGridTextColumn Header="Билетов" Binding="{ReflectionBinding TicketsSold}"/>
                                        <DataGridTextColumn Header="Средняя цена" Binding="{ReflectionBinding AverageTicketPrice, StringFormat={}{0:C}}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
        
                        <!-- Route Income Table -->
                        <Border Theme="{StaticResource ModernCard}" Margin="5" MinWidth="400" MaxWidth="800">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Text="Доход по маршрутам" Theme="{StaticResource SubHeaderText}" TextWrapping="Wrap"/>
                                <DataGrid Grid.Row="1" 
                                        ItemsSource="{Binding RouteIncomes}"
                                        AutoGenerateColumns="False"
                                        IsReadOnly="True"
                                        MinHeight="200"
                                        MaxHeight="400"
                                        HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Маршрут" Binding="{ReflectionBinding RouteName}"/>
                                        <DataGridTextColumn Header="Доход" Binding="{ReflectionBinding TotalIncome, StringFormat={}{0:C}}"/>
                                        <DataGridTextColumn Header="Билетов" Binding="{ReflectionBinding TicketsSold}"/>
                                        <DataGridTextColumn Header="Средняя цена" Binding="{ReflectionBinding AverageTicketPrice, StringFormat={}{0:C}}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </UserControl>