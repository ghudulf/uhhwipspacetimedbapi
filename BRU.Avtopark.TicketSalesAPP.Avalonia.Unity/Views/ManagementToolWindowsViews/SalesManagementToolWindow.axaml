<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:display="clr-namespace:BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Views.SalesManagementToolWindow"
             x:DataType="vm:SalesManagementViewModel">

    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <!-- Top Bar -->
        <Border Grid.Row="0" Background="#2D3436" Height="65">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,0">
                <StackPanel Grid.Column="0" 
                          Orientation="Horizontal" 
                          VerticalAlignment="Center"
                          Spacing="15">
                    <TextBlock Text="Период:" 
                             Foreground="White" 
                             VerticalAlignment="Center"
                             FontSize="14"/>
                    <DatePicker AutomationProperties.Name="Начальная дата продаж" SelectedDate="{Binding StartDate}"
                              Background="#34495e"
                              Foreground="White"
                              Width="150"/>
                    <TextBlock Text="-" 
                             Foreground="White" 
                             VerticalAlignment="Center"
                             FontSize="14"/>
                    <DatePicker AutomationProperties.Name="Конечная дата продаж" SelectedDate="{Binding EndDate}"
                              Background="#34495e"
                              Foreground="White"
                              Width="150"/>
                </StackPanel>

                <TextBlock Grid.Column="1" 
                         Text="{Binding TotalIncomeDisplay}"
                         Foreground="White"
                         FontSize="18"
                         FontWeight="Bold"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"/>

                <Button Grid.Column="2"
                        Command="{Binding AddCommand}"
                        Content="НОВАЯ ПРОДАЖА" IsEnabled="{Binding CanCreate}"
                        Background="#27ae60"
                        Foreground="White"
                        Padding="20,10"
                        FontSize="14"
                        FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="*,300">
            <!-- Sales DataGrid -->
            <DataGrid x:Name="SalesGrid" AutomationProperties.Name="Продажи" Grid.Column="0"
                     ItemsSource="{Binding Sales}"
                     SelectedItem="{Binding SelectedSale}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      DoubleTapped="OnSaleDoubleTapped"
                    
                     BorderThickness="0"
                     Margin="10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" 
                                      Binding="{ReflectionBinding SaleId}"
                                      Width="60"/>
                    <DataGridTextColumn Header="Дата"
                                      Binding="{ReflectionBinding SaleDateDisplay}"
                                      Width="150"/>
                    <DataGridTextColumn Header="ID Билета" 
                                      Binding="{ReflectionBinding TicketId}"
                                      Width="80"/>
                    <DataGridTextColumn Header="Покупатель"
                                      Binding="{ReflectionBinding TicketSoldToUser}"
                                      Width="150"/>
                    <DataGridTextColumn Header="Телефон"
                                      Binding="{ReflectionBinding TicketSoldToUserPhone}"
                                      Width="150"/>
                    <DataGridTextColumn Header="ID Продавца" 
                                      Binding="{ReflectionBinding SellerId}"
                                      Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Right Panel -->
            <StackPanel Grid.Column="1" 
                       Margin="0,10,10,10" 
                       Spacing="10">
                <Button Content="Печать чека"
                        HorizontalAlignment="Stretch"
                        Height="50"
                        Background="#3498db"
                        Foreground="White"
                        FontSize="14"/>
                
                <Button Content="Возврат"
                        HorizontalAlignment="Stretch"
                        Height="50"
                        Background="#e74c3c"
                        Foreground="White"
                        FontSize="14"
                        Command="{Binding DeleteCommand}"
                         IsEnabled="{Binding CanDelete}"/>

                <TextBlock AutomationProperties.LiveSetting="Polite" Text="{Binding ErrorMessage}"
                          Foreground="#c0392b"
                          TextWrapping="Wrap"
                          IsVisible="{Binding HasError}"
                          Margin="0,10"/>
            </StackPanel>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" 
                Background="#34495e" 
                Height="30">
            <TextBlock Text="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite"
                      Foreground="White"
                      VerticalAlignment="Center"
                      Margin="10,0"/>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="Назад" Command="{Binding PreviousPageCommand}"/>
            <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center"/>
            <Button Content="Далее" Command="{Binding NextPageCommand}"/>
            <Button Content="Обновить" Command="{Binding LoadDataCommand}"/>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="70"/>
        </StackPanel>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="VerticalGridLinesBrush" Value="#ecf0f1"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#ecf0f1"/>
        </Style>
        <Style Selector="DatePicker">
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </UserControl.Styles>
</UserControl>
