<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Views.ManagementToolWindowsViews.JobManagementToolWindow"
             x:DataType="vm:JobManagementViewModel">

    <Design.DataContext>
        <vm:JobManagementViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="10">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBox Grid.Column="0" 
                     Text="{Binding SearchText, Mode=TwoWay}"
                     AutomationProperties.Name="Поиск должностей"
                     PlaceholderText="Поиск по названию должности или требованиям к стажировке..."
                     Margin="0,0,10,0"/>
            <Button Grid.Column="1" 
                    Command="{Binding AddCommand}"
                    Content="Добавить должность"
                    IsEnabled="{Binding CanCreate}"/>
        </Grid>

        <TextBlock AutomationProperties.LiveSetting="Polite" Grid.Row="1" Text="{Binding SynchronizationMessage}" Margin="0,0,0,6" TextWrapping="Wrap"/>
        <DataGrid Grid.Row="2" AutomationProperties.Name="Должности"
                  ItemsSource="{Binding Jobs}"
                  SelectedItem="{Binding SelectedJob}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="All"
                  BorderThickness="1"
                  BorderBrush="Gray"
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" 
                                  Binding="{ReflectionBinding JobId}"
                                  Width="Auto"/>
                <DataGridTextColumn Header="Название должности" 
                                  Binding="{ReflectionBinding JobTitle}"
                                  Width="*"/>
                <DataGridTextColumn Header="Требования к стажировке" 
                                  Binding="{ReflectionBinding Internship}"
                                  Width="*"/>
                <DataGridTextColumn Header="Количество сотрудников" 
                                  Binding="{ReflectionBinding EmployeeCountDisplay}"
                                  Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto">
            <TextBlock AutomationProperties.LiveSetting="Polite" Grid.Column="0"
                       Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       IsVisible="{Binding HasError}"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" 
                    Command="{Binding EditCommand}"
                    Content="Редактировать"
                    IsEnabled="{Binding CanEdit}"
                    Margin="0,0,10,0"/>
            <Button Grid.Column="2" 
                    Command="{Binding DeleteCommand}"
                    Content="Удалить"
                    IsEnabled="{Binding CanDelete}"/>
        </Grid>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="Назад" Command="{Binding PreviousPageCommand}"/>
            <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center"/>
            <Button Content="Далее" Command="{Binding NextPageCommand}"/>
            <Button Content="Обновить" Command="{Binding LoadDataCommand}"/>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="70"/>
        </StackPanel>
    </Grid>
</UserControl>
