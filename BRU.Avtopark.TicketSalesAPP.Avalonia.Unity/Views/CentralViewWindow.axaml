<Window x:Class="BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Views.CentralViewWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.ViewModels"
        xmlns:icons="using:Material.Icons.Avalonia"
        mc:Ignorable="d"
        d:DesignWidth="1100" d:DesignHeight="700"
        x:DataType="viewModels:CentralViewWindowViewModel"
        Title="БРУ Автопарк — Система Управления"
        WindowStartupLocation="CenterScreen"
        CanResize="True" MinWidth="800" MinHeight="550"
        WindowDecorations="None"
        Background="#1C1C1E">

    <Window.Styles>
        <!-- Window control buttons -->
        <Style Selector="Button.WinBtn">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.WinBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A3A3C"/>
        </Style>
        <Style Selector="Button#CloseBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E81123"/>
        </Style>
        <Style Selector="Button.WinBtn icons|MaterialIcon">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Foreground" Value="#EBEBF5"/>
        </Style>

        <!-- Nav item buttons inside the drawer -->
        <Style Selector="Button.NavItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,2"/>
        </Style>
        <Style Selector="Button.NavItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A3A3C"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="32,*">

        <!-- CUSTOM TITLE BAR -->
        <Grid Grid.Row="0" Background="#1C1C1E" ColumnDefinitions="*,Auto">
            <Border Grid.Column="0"
                    Background="Transparent"
                    PointerPressed="TitleBarDragArea_PointerPressed"
                    DoubleTapped="TitleBarDragArea_DoubleTapped">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="12,0,0,0">
                    <icons:MaterialIcon Kind="Bus" Width="16" Height="16" Foreground="#636366"/>
                    <TextBlock Text="БРУ Автопарк — Система Управления"
                               FontSize="12" FontWeight="Medium"
                               Foreground="#EBEBF5"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="MinimizeBtn" Classes="WinBtn" Click="MinimizeButton_Click" ToolTip.Tip="Свернуть">
                    <icons:MaterialIcon Kind="WindowMinimize"/>
                </Button>
                <Button x:Name="MaximizeBtn" Classes="WinBtn" Click="MaximizeButton_Click" ToolTip.Tip="Развернуть">
                    <icons:MaterialIcon Kind="WindowMaximize"/>
                </Button>
                <Button x:Name="CloseBtn" Classes="WinBtn" Click="CloseButton_Click" ToolTip.Tip="Закрыть">
                    <icons:MaterialIcon Kind="WindowClose"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- DRAWER PAGE — compact navigation rail that expands to full nav list -->
        <DrawerPage Grid.Row="1"
                    IsOpen="{Binding IsNavPaneOpen}"
                    DrawerLayoutBehavior="CompactInline"
                    CompactDrawerLength="52"
                    DrawerLength="272"
                    DrawerBackground="#1C1C1E"
                    DrawerBehavior="Auto"
                    Background="#1C1C1E">

            <!-- Drawer content: icon rail + expanded nav list -->
            <DrawerPage.Drawer>
                <Grid ColumnDefinitions="52,220">

                    <!-- Icon rail (always visible) -->
                    <Border Grid.Column="0" Background="#1C1C1E"
                            BorderBrush="#2C2C2E" BorderThickness="0,0,1,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,8,0,0">
                                <Button Classes="NavItem" Padding="0" Width="52" Height="52"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding ShowBusManagementCommand}"
                                        ToolTip.Tip="Автобусы" ToolTip.Placement="Right">
                                    <icons:MaterialIcon Kind="Bus" Width="22" Height="22" Foreground="#8E8E93"/>
                                </Button>
                                <Button Classes="NavItem" Padding="0" Width="52" Height="52"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding ShowRouteManagementCommand}"
                                        ToolTip.Tip="Маршруты" ToolTip.Placement="Right">
                                    <icons:MaterialIcon Kind="MapMarkerPath" Width="22" Height="22" Foreground="#8E8E93"/>
                                </Button>
                                <Button Classes="NavItem" Padding="0" Width="52" Height="52"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding ShowRouteSchedulesCommand}"
                                        ToolTip.Tip="Расписание" ToolTip.Placement="Right">
                                    <icons:MaterialIcon Kind="CalendarClock" Width="22" Height="22" Foreground="#8E8E93"/>
                                </Button>
                                <Button Classes="NavItem" Padding="0" Width="52" Height="52"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding ShowTicketManagementCommand}"
                                        ToolTip.Tip="Билеты" ToolTip.Placement="Right">
                                    <icons:MaterialIcon Kind="Ticket" Width="22" Height="22" Foreground="#8E8E93"/>
                                </Button>
                                <Button Classes="NavItem" Padding="0" Width="52" Height="52"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding ShowSalesManagementCommand}"
                                        ToolTip.Tip="Продажи" ToolTip.Placement="Right">
                                    <icons:MaterialIcon Kind="CashRegister" Width="22" Height="22" Foreground="#8E8E93"/>
                                </Button>
                                <Button Classes="NavItem" Padding="0" Width="52" Height="52"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding ShowSalesStatisticsCommand}"
                                        ToolTip.Tip="Статистика" ToolTip.Placement="Right">
                                    <icons:MaterialIcon Kind="ChartBar" Width="22" Height="22" Foreground="#8E8E93"/>
                                </Button>
                                <Button Classes="NavItem" Padding="0" Width="52" Height="52"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding ShowEmployeeManagementCommand}"
                                        ToolTip.Tip="Сотрудники" ToolTip.Placement="Right">
                                    <icons:MaterialIcon Kind="AccountGroup" Width="22" Height="22" Foreground="#8E8E93"/>
                                </Button>
                                <Button Classes="NavItem" Padding="0" Width="52" Height="52"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding ShowJobManagementCommand}"
                                        ToolTip.Tip="Должности" ToolTip.Placement="Right">
                                    <icons:MaterialIcon Kind="Briefcase" Width="22" Height="22" Foreground="#8E8E93"/>
                                </Button>
                                <Button Classes="NavItem" Padding="0" Width="52" Height="52"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding ShowMaintenanceManagementCommand}"
                                        ToolTip.Tip="Обслуживание" ToolTip.Placement="Right">
                                    <icons:MaterialIcon Kind="Wrench" Width="22" Height="22" Foreground="#8E8E93"/>
                                </Button>
                                <Button Classes="NavItem" Padding="0" Width="52" Height="52"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding ShowUserManagementCommand}"
                                        ToolTip.Tip="Пользователи" ToolTip.Placement="Right">
                                    <icons:MaterialIcon Kind="ShieldAccount" Width="22" Height="22" Foreground="#8E8E93"/>
                                </Button>
                                <Button Classes="NavItem" Padding="0" Width="52" Height="52"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding ShowIncomeReportCommand}"
                                        ToolTip.Tip="Доходы" ToolTip.Placement="Right">
                                    <icons:MaterialIcon Kind="CurrencyRub" Width="22" Height="22" Foreground="#8E8E93"/>
                                </Button>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Spacing="2" Margin="0,0,0,8">
                                <Button Classes="NavItem" Padding="0" Width="52" Height="52"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding ShowWebSocketDebugCommand}"
                                        ToolTip.Tip="WebSocket Debug" ToolTip.Placement="Right">
                                    <icons:MaterialIcon Kind="Bug" Width="22" Height="22" Foreground="#8E8E93"/>
                                </Button>
                                <Button Classes="NavItem" Padding="0" Width="52" Height="52"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding OpenHelpCommand}"
                                        ToolTip.Tip="Справка" ToolTip.Placement="Right">
                                    <icons:MaterialIcon Kind="HelpCircle" Width="22" Height="22" Foreground="#8E8E93"/>
                                </Button>
                                <Button Classes="NavItem" Padding="0" Width="52" Height="52"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding OpenAboutCommand}"
                                        ToolTip.Tip="О программе" ToolTip.Placement="Right">
                                    <icons:MaterialIcon Kind="InformationOutline" Width="22" Height="22" Foreground="#8E8E93"/>
                                </Button>
                                <Button Classes="NavItem" Padding="0" Width="52" Height="52"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding ExitCommand}"
                                        ToolTip.Tip="Выход" ToolTip.Placement="Right">
                                    <icons:MaterialIcon Kind="ExitToApp" Width="22" Height="22" Foreground="#FF453A"/>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Expanded nav list (visible when drawer is open) -->
                    <Border Grid.Column="1" Background="#2C2C2E"
                            BorderBrush="#3A3A3C" BorderThickness="0,0,1,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top"
                                    Padding="16,14,16,10"
                                    BorderBrush="#3A3A3C" BorderThickness="0,0,0,1">
                                <TextBlock Text="Управление"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#EBEBF5"/>
                            </Border>
                            <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,6,0,6">

                                    <TextBlock Text="ТРАНСПОРТ" FontSize="10" FontWeight="Medium"
                                               Foreground="#636366" Margin="18,8,0,4"/>
                                    <Button Classes="NavItem" Command="{Binding ShowBusManagementCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <icons:MaterialIcon Kind="Bus" Width="18" Height="18" Foreground="#8E8E93"/>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Автобусы" FontSize="13" Foreground="#EBEBF5"/>
                                                <TextBlock Text="Парк транспортных средств" FontSize="11" Foreground="#636366"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="NavItem" Command="{Binding ShowRouteManagementCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <icons:MaterialIcon Kind="MapMarkerPath" Width="18" Height="18" Foreground="#8E8E93"/>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Маршруты" FontSize="13" Foreground="#EBEBF5"/>
                                                <TextBlock Text="Управление маршрутами" FontSize="11" Foreground="#636366"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="NavItem" Command="{Binding ShowRouteSchedulesCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <icons:MaterialIcon Kind="CalendarClock" Width="18" Height="18" Foreground="#8E8E93"/>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Расписание" FontSize="13" Foreground="#EBEBF5"/>
                                                <TextBlock Text="Расписание маршрутов" FontSize="11" Foreground="#636366"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="NavItem" Command="{Binding ShowMaintenanceManagementCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <icons:MaterialIcon Kind="Wrench" Width="18" Height="18" Foreground="#8E8E93"/>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Обслуживание" FontSize="13" Foreground="#EBEBF5"/>
                                                <TextBlock Text="ТО и ремонт" FontSize="11" Foreground="#636366"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Text="ПРОДАЖИ" FontSize="10" FontWeight="Medium"
                                               Foreground="#636366" Margin="18,12,0,4"/>
                                    <Button Classes="NavItem" Command="{Binding ShowTicketManagementCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <icons:MaterialIcon Kind="Ticket" Width="18" Height="18" Foreground="#8E8E93"/>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Билеты" FontSize="13" Foreground="#EBEBF5"/>
                                                <TextBlock Text="Управление билетами" FontSize="11" Foreground="#636366"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="NavItem" Command="{Binding ShowSalesManagementCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <icons:MaterialIcon Kind="CashRegister" Width="18" Height="18" Foreground="#8E8E93"/>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Продажи" FontSize="13" Foreground="#EBEBF5"/>
                                                <TextBlock Text="Кассовые операции" FontSize="11" Foreground="#636366"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="NavItem" Command="{Binding ShowSalesStatisticsCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <icons:MaterialIcon Kind="ChartBar" Width="18" Height="18" Foreground="#8E8E93"/>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Статистика" FontSize="13" Foreground="#EBEBF5"/>
                                                <TextBlock Text="Аналитика продаж" FontSize="11" Foreground="#636366"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="NavItem" Command="{Binding ShowIncomeReportCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <icons:MaterialIcon Kind="CurrencyRub" Width="18" Height="18" Foreground="#8E8E93"/>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Доходы" FontSize="13" Foreground="#EBEBF5"/>
                                                <TextBlock Text="Финансовые отчёты" FontSize="11" Foreground="#636366"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Text="ПЕРСОНАЛ" FontSize="10" FontWeight="Medium"
                                               Foreground="#636366" Margin="18,12,0,4"/>
                                    <Button Classes="NavItem" Command="{Binding ShowEmployeeManagementCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <icons:MaterialIcon Kind="AccountGroup" Width="18" Height="18" Foreground="#8E8E93"/>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Сотрудники" FontSize="13" Foreground="#EBEBF5"/>
                                                <TextBlock Text="Кадровый учёт" FontSize="11" Foreground="#636366"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="NavItem" Command="{Binding ShowJobManagementCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <icons:MaterialIcon Kind="Briefcase" Width="18" Height="18" Foreground="#8E8E93"/>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Должности" FontSize="13" Foreground="#EBEBF5"/>
                                                <TextBlock Text="Штатное расписание" FontSize="11" Foreground="#636366"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="NavItem" Command="{Binding ShowUserManagementCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <icons:MaterialIcon Kind="ShieldAccount" Width="18" Height="18" Foreground="#8E8E93"/>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Пользователи" FontSize="13" Foreground="#EBEBF5"/>
                                                <TextBlock Text="Права доступа" FontSize="11" Foreground="#636366"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                </Grid>
            </DrawerPage.Drawer>

            <!-- Main content area -->
            <ContentControl Content="{Binding CurrentView}" Background="#1C1C1E"/>

        </DrawerPage>

    </Grid>

</Window>