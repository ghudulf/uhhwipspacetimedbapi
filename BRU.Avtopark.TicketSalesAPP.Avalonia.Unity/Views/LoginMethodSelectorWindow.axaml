<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
        x:Class="BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Views.LoginMethodSelectorWindow"
        Title="БРУ Автопарк - Выбор метода входа"
        Width="500" Height="400"
        MinWidth="500" MinHeight="400"
        MaxWidth="500" MaxHeight="400"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/avalonia-logo.ico"
        CanResize="False"
        WindowDecorations="None"
        Background="{DynamicResource SystemBackground}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Light Mode Resources -->
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemBackgroundColor">#C0C0C0</Color>
                    <SolidColorBrush x:Key="SystemBackground" Color="{DynamicResource SystemBackgroundColor}"/>
                    
                    <Color x:Key="TitleBarBackgroundColor">#000080</Color>
                    <SolidColorBrush x:Key="TitleBarBackground" Color="{DynamicResource TitleBarBackgroundColor}"/>
                    <Color x:Key="TitleBarTextColor">#FFFFFF</Color>
                    <SolidColorBrush x:Key="TitleBarText" Color="{DynamicResource TitleBarTextColor}"/>
                    
                    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
                    <SolidColorBrush x:Key="CardBackground" Color="{DynamicResource CardBackgroundColor}"/>
                    <Color x:Key="BorderColor">#808080</Color>
                    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
                    
                    <Color x:Key="TextColor">#000000</Color>
                    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}"/>
                    <Color x:Key="MutedTextColor">#808080</Color>
                    <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}"/>
                    
                    <Color x:Key="ButtonBackgroundColor">#C0C0C0</Color>
                    <SolidColorBrush x:Key="ButtonBackground" Color="{DynamicResource ButtonBackgroundColor}"/>
                    <Color x:Key="ButtonHoverBackgroundColor">#D4D0C8</Color>
                    <SolidColorBrush x:Key="ButtonHoverBackground" Color="{DynamicResource ButtonHoverBackgroundColor}"/>
                </ResourceDictionary>
                
                <!-- Dark Mode Resources -->
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemBackgroundColor">#2D2D30</Color>
                    <SolidColorBrush x:Key="SystemBackground" Color="{DynamicResource SystemBackgroundColor}"/>
                    
                    <Color x:Key="TitleBarBackgroundColor">#1E1E1E</Color>
                    <SolidColorBrush x:Key="TitleBarBackground" Color="{DynamicResource TitleBarBackgroundColor}"/>
                    <Color x:Key="TitleBarTextColor">#FFFFFF</Color>
                    <SolidColorBrush x:Key="TitleBarText" Color="{DynamicResource TitleBarTextColor}"/>
                    
                    <Color x:Key="CardBackgroundColor">#252526</Color>
                    <SolidColorBrush x:Key="CardBackground" Color="{DynamicResource CardBackgroundColor}"/>
                    <Color x:Key="BorderColor">#3F3F46</Color>
                    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
                    
                    <Color x:Key="TextColor">#FFFFFF</Color>
                    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}"/>
                    <Color x:Key="MutedTextColor">#A0A0A0</Color>
                    <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}"/>
                    
                    <Color x:Key="ButtonBackgroundColor">#3E3E42</Color>
                    <SolidColorBrush x:Key="ButtonBackground" Color="{DynamicResource ButtonBackgroundColor}"/>
                    <Color x:Key="ButtonHoverBackgroundColor">#505052</Color>
                    <SolidColorBrush x:Key="ButtonHoverBackground" Color="{DynamicResource ButtonHoverBackgroundColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0" 
                Background="{DynamicResource TitleBarBackground}"
                IsHitTestVisible="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" 
                            Orientation="Horizontal" 
                            Spacing="8"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="🔐" 
                               FontSize="16" 
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Выбор метода входа" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TitleBarText}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Window Controls -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            Spacing="0">
                    <Button x:Name="CloseButton"
                            Width="46" Height="36"
                            Background="Transparent"
                            BorderThickness="0"
                            Content="✕"
                            Foreground="{DynamicResource TitleBarText}"
                            FontSize="14"
                            Padding="0"
                            VerticalContentAlignment="Center"
                            HorizontalContentAlignment="Center"
                            Click="CloseButton_Click">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#E81123"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Border Grid.Row="1" 
                Background="{DynamicResource SystemBackground}"
                Padding="20">
            <StackPanel Spacing="20" 
                        VerticalAlignment="Center">
                
                <!-- Header -->
                <StackPanel Spacing="10" 
                            HorizontalAlignment="Center">
                    <Border Width="80" Height="80"
                            Background="#000080"
                            CornerRadius="40"
                            HorizontalAlignment="Center">
                        <TextBlock Text="🚌" 
                                   FontSize="48"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="БРУ Автопарк" 
                               FontSize="20" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Выберите способ входа в систему" 
                               FontSize="12" 
                               Foreground="{DynamicResource MutedTextBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Login Method Cards -->
                <StackPanel Spacing="12">
                    
                    <!-- Traditional Login Button -->
                    <Border Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="2"
                            CornerRadius="0"
                            Padding="20,15"
                            Cursor="Hand"
                            PointerPressed="TraditionalLogin_Click">
                        <Border.Styles>
                            <Style Selector="Border:pointerover">
                                <Setter Property="BorderBrush" Value="#000080"/>
                                <Setter Property="Background" Value="#E8E8E8"/>
                            </Style>
                        </Border.Styles>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="48" Height="48"
                                    Background="#000080"
                                    CornerRadius="24"
                                    VerticalAlignment="Center"
                                    Margin="0,0,15,0">
                                <TextBlock Text="👤" 
                                           FontSize="24"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" 
                                        VerticalAlignment="Center"
                                        Spacing="4">
                                <TextBlock Text="Традиционный вход" 
                                           FontSize="14" 
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Вход с использованием имени пользователя и пароля" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="→" 
                                       FontSize="24"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- OAuth Login Button -->
                    <Border Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="2"
                            CornerRadius="0"
                            Padding="20,15"
                            Cursor="Hand"
                            PointerPressed="OAuthLogin_Click">
                        <Border.Styles>
                            <Style Selector="Border:pointerover">
                                <Setter Property="BorderBrush" Value="#000080"/>
                                <Setter Property="Background" Value="#E8E8E8"/>
                            </Style>
                        </Border.Styles>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="48" Height="48"
                                    Background="#000080"
                                    CornerRadius="24"
                                    VerticalAlignment="Center"
                                    Margin="0,0,15,0">
                                <TextBlock Text="🔐" 
                                           FontSize="24"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" 
                                        VerticalAlignment="Center"
                                        Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="OAuth / OpenID Connect" 
                                               FontSize="14" 
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <Border Background="#000080"
                                            CornerRadius="3"
                                            Padding="4,2">
                                        <TextBlock Text="Рекомендуется" 
                                                   FontSize="9" 
                                                   FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Безопасный вход через единую систему аутентификации" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="→" 
                                       FontSize="24"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                </StackPanel>

                <!-- Footer Info -->
                <Border Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Padding="12,10"
                        Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" 
                                Spacing="8"
                                HorizontalAlignment="Center">
                        <TextBlock Text="ℹ️" FontSize="14"/>
                        <TextBlock Text="OAuth обеспечивает повышенную безопасность и единый вход" 
                                   FontSize="10" 
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>
    </Grid>
</Window>
