<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Views.PasskeyCredentialsWindow"
        Title="Ключи доступа" AutomationProperties.Name="Ключи доступа"
        Width="520" Height="480" MinWidth="380" MinHeight="320" WindowStartupLocation="CenterOwner">
    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <TextBlock Text="Ключи доступа" FontSize="22" />
        <TextBlock Grid.Row="1" Text="Добавляйте ключи через системный браузер. Windows Hello доступен, если его поддерживают браузер и устройство. Удаление последнего ключа не проверяет другие способы входа." TextWrapping="Wrap" Margin="0,12" />
        <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.Name="Состояние ключей доступа" AutomationProperties.LiveSetting="Polite" />
        <ScrollViewer Grid.Row="3" Margin="0,12" AutomationProperties.Name="Список ключей доступа">
            <ItemsControl ItemsSource="{Binding Credentials}">
                <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6">
                    <TextBlock Text="{Binding CreatedAt, StringFormat='Ключ создан: {0:g}'}" />
                    <Button Content="Удалить" Click="Remove_Click" IsEnabled="{Binding $parent[Window].DataContext.CanMutate}" AutomationProperties.Name="Удалить этот ключ доступа" />
                </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <WrapPanel Grid.Row="4">
            <Button Content="Проверить список" Command="{Binding RefreshCommand}" AutomationProperties.Name="Проверить список ключей доступа" Margin="0,0,8,8" />
            <Button Content="Добавить ключ" Command="{Binding RegisterCommand}" AutomationProperties.Name="Зарегистрировать ключ доступа в браузере" Margin="0,0,8,8" />
            <Button Content="Закрыть" Click="Close_Click" IsCancel="True" AutomationProperties.Name="Закрыть управление ключами доступа" Margin="0,0,8,8" />
        </WrapPanel>
    </Grid>
</Window>
