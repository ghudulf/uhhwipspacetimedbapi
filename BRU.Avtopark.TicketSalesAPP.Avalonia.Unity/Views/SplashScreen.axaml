<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="460"
        x:Class="BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Views.SplashScreen"
        Title="Загрузка..."
        WindowStartupLocation="CenterScreen"
        Width="820" Height="460"
        CanResize="False"
        WindowDecorations="None"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent">

    <Border CornerRadius="0">
        <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0.0" Color="#FF1A2535"/>
                <GradientStop Offset="0.45" Color="#FF1E2D3D"/>
                <GradientStop Offset="0.7"  Color="#FF2A3040"/>
                <GradientStop Offset="1.0"  Color="#FF1A1F2E"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <!-- Subtle vignette overlay -->
            <Border>
                <Border.Background>
                    <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="70%" RadiusY="70%">
                        <GradientStop Offset="0.0" Color="#00000000"/>
                        <GradientStop Offset="1.0" Color="#88000000"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- Top logo area -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,32,0,0" Spacing="6">
                <!-- Logo box mimicking the DevExpress style icon -->
                <Border HorizontalAlignment="Center"
                        Background="#CC1A2535"
                        BorderBrush="#55FFFFFF"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- Simple bus icon using shapes -->
                        <Canvas Width="22" Height="16" VerticalAlignment="Center">
                            <Rectangle Canvas.Left="0" Canvas.Top="2" Width="22" Height="12" Fill="#FFFFFFFF" RadiusX="2" RadiusY="2"/>
                            <Rectangle Canvas.Left="2" Canvas.Top="0" Width="18" Height="8" Fill="#FFFFFFFF" RadiusX="2" RadiusY="2"/>
                            <Ellipse Canvas.Left="3" Canvas.Top="11" Width="5" Height="5" Fill="#FF1A2535"/>
                            <Ellipse Canvas.Left="14" Canvas.Top="11" Width="5" Height="5" Fill="#FF1A2535"/>
                        </Canvas>
                        <TextBlock Text="БРУ Автопарк"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Center content -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="Система управления"
                           FontSize="36"
                           FontWeight="Light"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           LetterSpacing="1"/>
                <TextBlock Text="автобусным парком БРУ"
                           FontSize="18"
                           FontWeight="Light"
                           Foreground="#CCFFFFFF"
                           HorizontalAlignment="Center"
                           LetterSpacing="0.5"/>

                <!-- Animated dots loader -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0" Spacing="8">
                    <Ellipse Name="Dot1" Width="9" Height="9" Fill="#AAFFFFFF"/>
                    <Ellipse Name="Dot2" Width="9" Height="9" Fill="#55FFFFFF"/>
                    <Ellipse Name="Dot3" Width="9" Height="9" Fill="#33FFFFFF"/>
                    <Ellipse Name="Dot4" Width="9" Height="9" Fill="#22FFFFFF"/>
                </StackPanel>
            </StackPanel>

            <!-- Bottom bar -->
            <Grid VerticalAlignment="Bottom" Margin="24,0,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="© 2025 Белорусско-российский университет."
                               Foreground="#66FFFFFF"
                               FontSize="11"/>
                    <TextBlock Text="Все права защищены. Версия 0.5A"
                               Foreground="#44FFFFFF"
                               FontSize="11"/>
                </StackPanel>

                <TextBlock Name="StatusMessage"
                           Grid.Column="1"
                           Text="Запуск..."
                           Foreground="#88FFFFFF"
                           FontSize="12"
                           VerticalAlignment="Bottom"
                           FontStyle="Italic"/>
            </Grid>

            <!-- Error overlay (hidden by default) -->
            <Border Name="ErrorPanel"
                    IsVisible="False"
                    Background="#CC1A0000"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,50"
                    Padding="16,8">
                <TextBlock Name="ErrorMessage"
                           Foreground="#FFFF6B6B"
                           FontSize="13"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           MaxWidth="600"
                           Text="Ошибка подключения к серверу"/>
            </Border>
        </Grid>
    </Border>
</Window>
