<UserControl x:Class="BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Views.Explorer"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <TreeView AutomationProperties.Name="Проводник проекта">
        <TreeViewItem Header=".git">
            <TreeViewItem Header="hooks">
                <TreeViewItem AutomationProperties.Name="Содержимое папки hooks" />
            </TreeViewItem>
            <TreeViewItem Header="info">
                <TreeViewItem AutomationProperties.Name="Содержимое папки info" />
            </TreeViewItem>
            <TreeViewItem Header="logs">
                <TreeViewItem AutomationProperties.Name="Содержимое папки logs" />
            </TreeViewItem>
            <TreeViewItem Header="objects">
                <TreeViewItem AutomationProperties.Name="Содержимое папки objects" />
            </TreeViewItem>
            <TreeViewItem Header="refs">
                <TreeViewItem AutomationProperties.Name="Содержимое папки refs" />
            </TreeViewItem>

            <TreeViewItem Header="config" />
            <TreeViewItem Header="description" />
            <TreeViewItem Header="FETCH_HEAD" />
            <TreeViewItem Header="HEAD" />
            <TreeViewItem Header="index" />
            <TreeViewItem Header="ORIG_HEAD" />
        </TreeViewItem>
        <TreeViewItem Header="BRU.Avtopark.TicketSalesAPP.Avalonia.Unity">
            <TreeViewItem AutomationProperties.Name="Содержимое проекта" />
        </TreeViewItem>
        <TreeViewItem Header="BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.Sample">
            <TreeViewItem AutomationProperties.Name="Содержимое примера" />
        </TreeViewItem>
        <TreeViewItem Header=".editorconfig" />
        <TreeViewItem Header=".gitignore" />
        <TreeViewItem Header="Directory.Package.props" />
        <TreeViewItem Header="LICENSE" />
        <TreeViewItem Header="README.md" />
        <TreeViewItem Header="BRU.Avtopark.TicketSalesAPP.Avalonia.Unity.sln" />
    </TreeView>
</UserControl>
