@using BRU_AVTOPARK.Models.ViewModels
@model ProfileViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Your Profile";
}

@* ── Profile Card ──────────────────────────────────────────────── *@
<section class="section">
    <div class="section__inner">
        <div class="profile-card" data-testid="profile-card">
            <div class="profile-card__avatar">
                <div class="user-avatar user-avatar--large">
                    <img src="@Model.User.AvatarUrl"
                         alt="Profile picture for @Html.Encode(Model.User.Login)"
                         class="user-avatar__image" />
                </div>
            </div>
            <h1 class="text text--heading-l profile-card__name">
                @Html.Encode(Model.User.Login)
            </h1>
            <div class="text text--m profile-card__description">
                @if (!string.IsNullOrEmpty(Model.User.PhoneNumber))
                {
                    <span class="bulleted-item">@Html.Encode(Model.User.PhoneNumber)</span>
                }
                @if (!string.IsNullOrEmpty(Model.User.Email))
                {
                    <span class="bulleted-item">@Html.Encode(Model.User.Email)</span>
                }
                @if (string.IsNullOrEmpty(Model.User.PhoneNumber) && string.IsNullOrEmpty(Model.User.Email))
                {
                    <span class="bulleted-item">No contact information provided</span>
                }
            </div>
        </div>
    </div>
</section>

@* ── Security Section ──────────────────────────────────────────── *@
<section class="section">
    <div class="section__inner">
        <div class="section__heading">
            <h2 class="text text--heading-m" style="display: flex; align-items: center; gap: 12px;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                Security
            </h2>
        </div>

        <div class="list-plain">
            @* TOTP *@
            <div class="list-item">
                <div class="list-item__content">
                    <span class="text text--m">Two-Factor Authentication</span>
                    <span class="text text--s text--secondary">
                        @if (Model.TotpEnabled)
                        {
                            <span style="display: inline-flex; align-items: center; gap: 6px;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--success-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                                    <polyline points="22 4 12 14.01 9 11.01"/>
                                </svg>
                                Enabled - App-based code
                            </span>
                        }
                        else
                        {
                            <span style="display: inline-flex; align-items: center; gap: 6px;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="12" cy="12" r="10"/>
                                    <line x1="15" y1="9" x2="9" y2="15"/>
                                    <line x1="9" y1="9" x2="15" y2="15"/>
                                </svg>
                                Disabled
                            </span>
                        }
                    </span>
                </div>
                <div class="list-item__action">
                    @if (Model.TotpEnabled)
                    {
                        <form method="POST" action="/api/auth/totp/disable">
                            <button type="submit" class="btn btn--text btn--danger">Disable</button>
                        </form>
                    }
                    else
                    {
                        <a href="/api/auth/totp/setup" class="btn btn--text">Enable</a>
                    }
                </div>
            </div>
            <hr class="list-divider" />

            @* WebAuthn *@
            <div class="list-item">
                <div class="list-item__content">
                    <span class="text text--m">Security Keys & Biometrics</span>
                    <span class="text text--s text--secondary">
                        @if (Model.WebAuthnCredentials.Count > 0)
                        {
                            <span style="display: inline-flex; align-items: center; gap: 6px;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--success-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                                    <polyline points="22 4 12 14.01 9 11.01"/>
                                </svg>
                                @Model.WebAuthnCredentials.Count key(s) registered
                            </span>
                        }
                        else
                        {
                            <span>No keys registered</span>
                        }
                    </span>
                </div>
                <div class="list-item__action">
                    <a href="/api/auth/webauthn/register/options" class="btn btn--text">
                        @(Model.WebAuthnCredentials.Count > 0 ? "Manage" : "Add")
                    </a>
                </div>
            </div>

            @* Individual WebAuthn keys *@
            @foreach (var credential in Model.WebAuthnCredentials)
            {
                <hr class="list-divider" />
                <div class="list-item">
                    <div class="list-item__content">
                        <span class="text text--m" style="display: flex; align-items: center; gap: 8px;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
                            </svg>
                            Security Key
                        </span>
                        <span class="text text--s text--secondary">Added: @credential.CreatedAt.ToString("dd.MM.yyyy")</span>
                        <span class="text text--xs text--tertiary" style="font-family: var(--font-mono);">ID: @credential.Id[..Math.Min(12, credential.Id.Length)]...</span>
                    </div>
                    <div class="list-item__action">
                        <form method="POST"
                              action="/api/auth/webauthn/credentials/@Uri.EscapeDataString(credential.Id)"
                              onsubmit="return confirm('Remove this security key?');">
                            <input type="hidden" name="_method" value="DELETE" />
                            <button type="submit" class="btn btn--text btn--danger">Remove</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@* ── Roles & Permissions Section ───────────────────────────────── *@
<section class="section">
    <div class="section__inner">
        <div class="section__heading">
            <h2 class="text text--heading-m" style="display: flex; align-items: center; gap: 12px;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
                Roles & Permissions
            </h2>
        </div>

        <div class="list-plain">
            <div class="list-item">
                <div class="list-item__content">
                    <span class="text text--m">Roles</span>
                    <span class="text text--s text--secondary">
                        @if (Model.Roles.Any())
                        {
                            @string.Join(", ", Model.Roles.Select(r => r.Name))
                        }
                        else
                        {
                            <span>No roles assigned</span>
                        }
                    </span>
                </div>
            </div>
            <hr class="list-divider" />
            <div class="list-item">
                <div class="list-item__content list-item__content--top">
                    <span class="text text--m">Permissions</span>
                    @if (Model.Permissions.Any())
                    {
                        <div class="badge-list">
                            @foreach (var perm in Model.Permissions)
                            {
                                <span class="badge">@Html.Encode(perm.Name)</span>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="text text--s text--secondary">No special permissions</span>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@* ── Admin Section (conditional) ───────────────────────────────── *@
@if (Model.IsAdmin)
{
    <section class="section">
        <div class="section__inner">
            <div class="section__heading">
                <h2 class="text text--heading-m" style="display: flex; align-items: center; gap: 12px;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="3"/>
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                    </svg>
                    Administration
                </h2>
            </div>

            <div class="admin-cards">
                <a href="/api/auth/register" class="admin-card">
                    <div class="admin-card__icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="8.5" cy="7" r="4"/>
                            <line x1="20" y1="8" x2="20" y2="14"/>
                            <line x1="23" y1="11" x2="17" y2="11"/>
                        </svg>
                    </div>
                    <span class="admin-card__title">Register User</span>
                    <span class="admin-card__subtitle">Create new accounts</span>
                </a>

                <a href="/api/auth/connect/clients" class="admin-card oidc-clients-link">
                    <div class="admin-card__icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        </svg>
                    </div>
                    <span class="admin-card__title">OIDC Client Management</span>
                    <span class="admin-card__subtitle">Configure OAuth clients</span>
                </a>
            </div>
        </div>
    </section>
}

@* ── Logout ──────────────────────────────────────────────────────── *@
<div class="text-center" style="margin-top: 2rem; margin-bottom: 2rem;">
    <a href="/api/auth/logout" class="btn btn--danger btn--lg" style="width: auto; min-width: 180px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <polyline points="16 17 21 12 16 7"/>
            <line x1="21" y1="12" x2="9" y2="12"/>
        </svg>
        <span>Logout</span>
    </a>
</div>

@section Scripts {
    <script>
        // Pass token to OIDC clients link for admin navigation
        document.addEventListener('DOMContentLoaded', function () {
            const token = localStorage.getItem('auth_token')
                || new URLSearchParams(window.location.search).get('token');
            if (token) {
                const link = document.querySelector('.oidc-clients-link');
                if (link) link.href += '?token=' + encodeURIComponent(token);
            }
        });
    </script>
}
