@* Section wrapper - Modern Liquid Glass Design *@
@{
    var title = ViewData["SectionTitle"]?.ToString();
    var icon = ViewData["SectionIcon"]?.ToString();
    var description = ViewData["SectionDescription"]?.ToString();
}

<section class="section-wrapper glass-card slide-up">
    <div class="section-inner">
        @if (!string.IsNullOrEmpty(title))
        {
            <div class="section-heading">
                @if (!string.IsNullOrEmpty(icon))
                {
                    <div class="section-icon-wrapper">
                        @Html.Raw(icon)
                    </div>
                }
                <div class="section-title-group">
                    <h2 class="section-title">@title</h2>
                    @if (!string.IsNullOrEmpty(description))
                    {
                        <p class="section-description">@description</p>
                    }
                </div>
            </div>
        }
        <div class="section-content">
            @RenderBody()
        </div>
    </div>
</section>

<style>
    .section-wrapper {
        padding: 1.5rem;
        border-radius: var(--radius-xl);
        margin-bottom: 1.5rem;
    }
    .section-inner {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }
    .section-heading {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border);
    }
    .section-icon-wrapper {
        width: 44px;
        height: 44px;
        background: var(--primary-alpha);
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .section-icon-wrapper svg {
        width: 22px;
        height: 22px;
        color: var(--primary);
    }
    .section-title-group {
        flex: 1;
    }
    .section-title {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--text-primary);
    }
    .section-description {
        margin: 0.25rem 0 0 0;
        font-size: 0.875rem;
        color: var(--text-secondary);
    }
    .section-content {
        min-height: 0;
    }
</style>
