@using BRU_AVTOPARK.Models.ViewModels
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#0066ff">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>@ViewData["Title"] - BRU AVTOPARK</title>
    <link rel="stylesheet" href="~/css/bru-design-system.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <style>
        /* Critical CSS for instant paint */
        html { background: #f0f4f8; }
        [data-theme="dark"] html { background: #0f172a; }
    </style>
</head>
<body class="@ViewData["BodyClass"]">
    <header class="header-wrapper" role="navigation" aria-label="Main navigation">
        <!-- Logo Panel -->
        <a href="/" class="header-logo-panel" aria-label="BRU AVTOPARK Home">
            <span class="logo-icon" aria-hidden="true"></span>
            <span class="logo-text">BRU AVTOPARK</span>
        </a>
        
        <!-- Controls Panel -->
        <div class="header-controls-panel">
            <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode" type="button">
                <span class="theme-icon-light" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="5"/>
                        <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
                    </svg>
                </span>
                <span class="theme-icon-dark" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                    </svg>
                </span>
            </button>
        </div>
    </header>

    <main id="main-content">
        @RenderBody()
    </main>

    <script src="~/js/theme-toggle.js" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
