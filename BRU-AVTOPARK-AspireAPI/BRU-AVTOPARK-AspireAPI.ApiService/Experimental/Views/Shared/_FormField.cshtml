@using BRU_AVTOPARK.Models.ViewModels
@model FormFieldViewModel

<div class="form-group">
    <label for="@Model.Id">@Model.Label</label>
    <input type="@Model.Type"
           id="@Model.Id"
           name="@Model.Id"
           placeholder="@Model.Placeholder"
           value="@Model.Value"
           autocomplete="@(Model.Type == "password" ? "current-password" : Model.Type == "email" ? "email" : "off")"
           @(Model.Required ? "required" : "")
           aria-required="@(Model.Required ? "true" : "false")" />
</div>
