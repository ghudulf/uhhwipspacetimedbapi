@using BRU_AVTOPARK.Models.ViewModels
@model StatusViewModel

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="status-message status-message--error" role="alert" aria-live="polite">
        <svg class="status-message__icon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="15" y1="9" x2="9" y2="15"/>
            <line x1="9" y1="9" x2="15" y2="15"/>
        </svg>
        <span>@Model.Error</span>
    </div>
}

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="status-message status-message--success" role="status" aria-live="polite">
        <svg class="status-message__icon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        <span>@Model.Message</span>
    </div>
}
