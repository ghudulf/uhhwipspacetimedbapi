@using BRU_AVTOPARK.Models.ViewModels
@model StatusViewModel

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="status-message status-message--error" role="alert">
        <svg class="status-message__icon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" />
            <path d="M12 8v4m0 4h.01" />
        </svg>
        <span>@Model.Error</span>
    </div>
}

@if (!string.IsNullOrEmpty(Model.Success))
{
    <div class="status-message status-message--success" role="status">
        <svg class="status-message__icon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" />
            <path d="M8 12l3 3 5-6" />
        </svg>
        <span>@Model.Success</span>
    </div>
}
