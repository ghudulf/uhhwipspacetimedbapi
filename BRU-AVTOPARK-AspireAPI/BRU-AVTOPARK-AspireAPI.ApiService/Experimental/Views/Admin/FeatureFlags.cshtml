@* Feature Flags Admin UI - Modern glass design *@
@model dynamic

@{
    var flags = Model?.Flags ?? new Dictionary<string, bool>();
    var auditLog = Model?.AuditLog ?? new List<dynamic>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0066ff">
    <title>Feature Flags - BRU AVTOPARK Admin</title>
    <link rel="stylesheet" href="~/css/bru-design-system.css">
    <style>html{background-color:#121212}html[data-theme="light"]{background-color:#F0F0F0}</style>
    <script>(function(){var t=localStorage.getItem('theme')||(window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');document.documentElement.setAttribute('data-theme',t);var m=document.querySelector('meta[name="theme-color"]');if(m)m.setAttribute('content',t==='dark'?'#121212':'#F0F0F0');})()</script>
</head>
<body>
    <header class="header-wrapper" role="navigation">
        <a href="/" class="header-logo-panel" aria-label="BRU AVTOPARK Home">
            <span class="logo-icon" aria-hidden="true"></span>
            <span class="logo-text">BRU AVTOPARK</span>
        </a>
        <div class="header-controls-panel">
            <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode" type="button">
                <span class="theme-icon-light" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="5"/>
                        <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
                    </svg>
                </span>
                <span class="theme-icon-dark" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                    </svg>
                </span>
            </button>
        </div>
    </header>
    
    <div class="container" style="max-width: 1200px;">
        <div class="page-header">
            <div>
                <h1 class="page-title" style="display: flex; align-items: center; gap: 12px;">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/>
                        <line x1="4" y1="22" x2="4" y2="15"/>
                    </svg>
                    Feature Flags Management
                </h1>
                <p class="page-subtitle">Control gradual rollout of refactored authentication endpoints</p>
            </div>
            <div class="bulk-actions">
                <button class="bulk-action-btn bulk-action-secondary" onclick="enableCategory('Login')" type="button">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                        <polyline points="10 17 15 12 10 7"/>
                        <line x1="15" y1="12" x2="3" y2="12"/>
                    </svg>
                    Enable Login
                </button>
                <button class="bulk-action-btn bulk-action-secondary" onclick="enableCategory('Totp')" type="button">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                    Enable TOTP
                </button>
                <button class="bulk-action-btn bulk-action-secondary" onclick="enableCategory('WebAuthn')" type="button">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
                    </svg>
                    Enable WebAuthn
                </button>
                <button class="bulk-action-btn bulk-action-secondary" onclick="enableCategory('OAuth')" type="button">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                    Enable OAuth
                </button>
                <button class="bulk-action-btn bulk-action-danger" onclick="confirmReset()" type="button">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="1 4 1 10 7 10"/>
                        <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
                    </svg>
                    Reset All
                </button>
            </div>
        </div>

        <div id="alertContainer" aria-live="polite"></div>

        <div class="flags-section fade-in">
            <div id="flagsContainer">
                <div class="text-center" style="padding: 2rem;">
                    <div class="loader" aria-label="Loading feature flags"></div>
                    <p style="color: var(--text-muted); margin-top: 1rem;">Loading feature flags...</p>
                </div>
            </div>
        </div>

        <div class="audit-log-section fade-in">
            <div class="audit-log-header">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                    <line x1="16" y1="13" x2="8" y2="13"/>
                    <line x1="16" y1="17" x2="8" y2="17"/>
                    <polyline points="10 9 9 9 8 9"/>
                </svg>
                Recent Changes
            </div>
            <div id="auditLogContainer">
                <div class="text-center" style="padding: 2rem;">
                    <div class="loader" aria-label="Loading audit log"></div>
                    <p style="color: var(--text-muted); margin-top: 1rem;">Loading audit log...</p>
                </div>
            </div>
        </div>
        
        <div class="mt-8 text-center">
            <a href="/api/auth/profile" class="link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 4px;" aria-hidden="true">
                    <line x1="19" y1="12" x2="5" y2="12"/>
                    <polyline points="12 19 5 12 12 5"/>
                </svg>
                Back to Profile
            </a>
        </div>
    </div>

    <!-- Confirmation Modal -->
    <div id="confirmModal" class="modal" role="dialog" aria-labelledby="modalTitle" aria-modal="true">
        <div class="modal-content">
            <h2 class="modal-header" id="modalTitle">Confirm Action</h2>
            <p class="modal-body" id="modalBody">Are you sure?</p>
            <div class="modal-actions">
                <button class="btn btn--secondary" onclick="closeModal()" type="button" style="width: auto;">Cancel</button>
                <button class="btn btn--primary" id="modalConfirmBtn" onclick="confirmAction()" type="button" style="width: auto;">Confirm</button>
            </div>
        </div>
    </div>
    
    <script src="~/js/theme-toggle.js" defer></script>
    <script src="~/js/header-scroll.js" defer></script>
    <script>
        let pendingAction = null;
        let allFlags = {};

        // Load feature flags on page load
        document.addEventListener('DOMContentLoaded', function() {
            loadFeatureFlags();
            loadAuditLog();
        });

        async function loadFeatureFlags() {
            try {
                const response = await fetch('/api/admin/feature-flags', {
                    headers: {
                        'Authorization': 'Bearer ' + getAuthToken()
                    }
                });

                if (!response.ok) {
                    throw new Error('Failed to load feature flags');
                }

                const data = await response.json();
                allFlags = data.flags;
                renderFlags(allFlags);
            } catch (error) {
                console.error('Error loading feature flags:', error);
                showAlert('Failed to load feature flags: ' + error.message, 'error');
            }
        }

        function renderFlags(flags) {
            const categories = {
                'Authentication': ['EnableLoginRefactoring', 'EnableRegisterRefactoring'],
                'TOTP': ['EnableTotpSetupRefactoring', 'EnableTotpValidateRefactoring', 'EnableTotpEnableRefactoring', 'EnableTotpDisableRefactoring'],
                'WebAuthn': ['EnableWebAuthnRegisterRefactoring', 'EnableWebAuthnValidateRefactoring', 'EnableWebAuthnCredentialsRefactoring', 'EnableWebAuthnRemoveRefactoring'],
                'OAuth': ['EnableOAuthAuthorizeRefactoring', 'EnableOAuthTokenRefactoring', 'EnableOAuthUserInfoRefactoring', 'EnableOAuthClientRegisterRefactoring', 'EnableOAuthClientUpdateRefactoring', 'EnableOAuthClientDeleteRefactoring', 'EnableOAuthClientsListRefactoring', 'EnableOAuthScopesRefactoring'],
                'Magic Link': ['EnableMagicLinkSendRefactoring', 'EnableMagicLinkValidateRefactoring'],
                'QR Authentication': ['EnableQRGenerateRefactoring', 'EnableQRValidateRefactoring'],
                'Profile': ['EnableProfileGetRefactoring', 'EnableProfileUpdateRefactoring'],
                'User Management': ['EnableUserGetRefactoring', 'EnableUsersListRefactoring']
            };

            let html = '';
            for (const [category, flagNames] of Object.entries(categories)) {
                html += `<div class="flags-category">`;
                html += `<div class="category-header">${category}</div>`;
                
                for (const flagName of flagNames) {
                    if (flags.hasOwnProperty(flagName)) {
                        const enabled = flags[flagName];
                        const checked = enabled ? 'checked' : '';
                        const id = `flag-${flagName}`;
                        html += `
                            <div class="flag-item">
                                <div class="flag-info">
                                    <label for="${id}" class="flag-name">${flagName}</label>
                                </div>
                                <label class="toggle-switch">
                                    <input type="checkbox" id="${id}" ${checked} onchange="toggleFlag('${flagName}', this.checked)" aria-label="Toggle ${flagName}">
                                    <span class="toggle-slider"></span>
                                </label>
                            </div>
                        `;
                    }
                }
                html += `</div>`;
            }

            document.getElementById('flagsContainer').innerHTML = html;
        }

        async function toggleFlag(flagName, enabled) {
            try {
                const response = await fetch(`/api/admin/feature-flags/${flagName}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + getAuthToken()
                    },
                    body: JSON.stringify({ enabled: enabled })
                });

                if (!response.ok) {
                    throw new Error('Failed to update feature flag');
                }

                allFlags[flagName] = enabled;
                showAlert(`Feature flag ${flagName} ${enabled ? 'enabled' : 'disabled'} successfully`, 'success');
                loadAuditLog();
            } catch (error) {
                console.error('Error updating feature flag:', error);
                showAlert('Failed to update feature flag: ' + error.message, 'error');
                // Revert toggle
                loadFeatureFlags();
            }
        }

        async function enableCategory(category) {
            const categoryFlags = {
                'Login': ['EnableLoginRefactoring', 'EnableRegisterRefactoring'],
                'Totp': ['EnableTotpSetupRefactoring', 'EnableTotpValidateRefactoring', 'EnableTotpEnableRefactoring', 'EnableTotpDisableRefactoring'],
                'WebAuthn': ['EnableWebAuthnRegisterRefactoring', 'EnableWebAuthnValidateRefactoring', 'EnableWebAuthnCredentialsRefactoring', 'EnableWebAuthnRemoveRefactoring'],
                'OAuth': ['EnableOAuthAuthorizeRefactoring', 'EnableOAuthTokenRefactoring', 'EnableOAuthUserInfoRefactoring', 'EnableOAuthClientRegisterRefactoring', 'EnableOAuthClientUpdateRefactoring', 'EnableOAuthClientDeleteRefactoring', 'EnableOAuthClientsListRefactoring', 'EnableOAuthScopesRefactoring']
            };

            const flags = categoryFlags[category];
            if (!flags) return;

            const flagsToUpdate = {};
            flags.forEach(flag => {
                flagsToUpdate[flag] = true;
            });

            try {
                const response = await fetch('/api/admin/feature-flags/bulk', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + getAuthToken()
                    },
                    body: JSON.stringify({ flags: flagsToUpdate })
                });

                if (!response.ok) {
                    throw new Error('Failed to enable category');
                }

                showAlert(`All ${category} endpoints enabled successfully`, 'success');
                loadFeatureFlags();
                loadAuditLog();
            } catch (error) {
                console.error('Error enabling category:', error);
                showAlert('Failed to enable category: ' + error.message, 'error');
            }
        }

        function confirmReset() {
            pendingAction = resetAllFlags;
            document.getElementById('modalTitle').textContent = 'Reset All Feature Flags';
            document.getElementById('modalBody').textContent = 'This will reset all feature flags to their default values from appsettings.json. All runtime overrides will be cleared. Are you sure?';
            document.getElementById('confirmModal').style.display = 'block';
        }

        async function resetAllFlags() {
            try {
                const response = await fetch('/api/admin/feature-flags/reset', {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + getAuthToken()
                    }
                });

                if (!response.ok) {
                    throw new Error('Failed to reset feature flags');
                }

                showAlert('All feature flags reset to defaults successfully', 'success');
                loadFeatureFlags();
                loadAuditLog();
            } catch (error) {
                console.error('Error resetting feature flags:', error);
                showAlert('Failed to reset feature flags: ' + error.message, 'error');
            }
        }

        async function loadAuditLog() {
            try {
                const response = await fetch('/api/admin/feature-flags/audit-log?limit=20', {
                    headers: {
                        'Authorization': 'Bearer ' + getAuthToken()
                    }
                });

                if (!response.ok) {
                    throw new Error('Failed to load audit log');
                }

                const data = await response.json();
                renderAuditLog(data.auditLog);
            } catch (error) {
                console.error('Error loading audit log:', error);
                document.getElementById('auditLogContainer').innerHTML = '<p style="text-align: center; color: var(--text-muted); padding: 2rem;">Failed to load audit log</p>';
            }
        }

        function renderAuditLog(auditLog) {
            if (!auditLog || auditLog.length === 0) {
                document.getElementById('auditLogContainer').innerHTML = '<p style="text-align: center; color: var(--text-muted); padding: 2rem;">No changes recorded yet</p>';
                return;
            }

            let html = `
                <div style="overflow-x: auto;">
                    <table class="audit-log-table">
                        <thead>
                            <tr>
                                <th>Flag Name</th>
                                <th>Status</th>
                                <th>Changed By</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
            `;

            auditLog.forEach(entry => {
                const statusClass = entry.enabled ? 'status-enabled' : 'status-disabled';
                const statusText = entry.enabled ? 'Enabled' : 'Disabled';
                const date = new Date(entry.updatedAt).toLocaleString();
                
                html += `
                    <tr>
                        <td style="font-family: var(--font-mono);">${entry.flagName}</td>
                        <td><span class="status-badge ${statusClass}">${statusText}</span></td>
                        <td>${entry.updatedByUsername}</td>
                        <td>${date}</td>
                    </tr>
                `;
            });

            html += `
                        </tbody>
                    </table>
                </div>
            `;

            document.getElementById('auditLogContainer').innerHTML = html;
        }

        function confirmAction() {
            if (pendingAction) {
                pendingAction();
            }
            closeModal();
        }

        function closeModal() {
            document.getElementById('confirmModal').style.display = 'none';
            pendingAction = null;
        }

        function showAlert(message, type) {
            const container = document.getElementById('alertContainer');
            const alert = document.createElement('div');
            alert.className = `alert alert-${type}`;
            alert.style.display = 'flex';
            alert.style.alignItems = 'center';
            alert.style.gap = '8px';
            
            const icon = type === 'success' 
                ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>'
                : '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>';
            
            alert.innerHTML = icon + message;
            container.appendChild(alert);
            
            setTimeout(() => {
                alert.style.opacity = '0';
                alert.style.transition = 'opacity 0.3s ease';
                setTimeout(() => alert.remove(), 300);
            }, 5000);
        }

        function getAuthToken() {
            return localStorage.getItem('auth_token') 
                || new URLSearchParams(window.location.search).get('token')
                || '';
        }

        // Close modal on escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeModal();
            }
        });

        // Close modal on backdrop click
        document.getElementById('confirmModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeModal();
            }
        });
    </script>
</body>
</html>
