@* OAuth Clients List View - Modern glass design *@
@model dynamic

@{
    var clients = Model?.Clients ?? new List<dynamic>();
    var token = Model?.Token;
    var tokenParam = !string.IsNullOrEmpty(token) ? $"?token={System.Web.HttpUtility.UrlEncode(token)}" : "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0066ff">
    <title>OAuth Clients - BRU AVTOPARK</title>
    <link rel="stylesheet" href="~/css/bru-design-system.css">
    <style>html{background-color:#121212}html[data-theme="light"]{background-color:#F0F0F0}</style>
    <script>(function(){var t=localStorage.getItem('theme')||(window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');if(t==='dark'){document.documentElement.setAttribute('data-theme','dark');document.documentElement.style.backgroundColor='#121212';}else{document.documentElement.style.backgroundColor='#F0F0F0';}var m=document.querySelector('meta[name="theme-color"]');if(m)m.setAttribute('content',t==='dark'?'#121212':'#F0F0F0');})()</script>
</head>
<body>
    <header class="header-wrapper" role="navigation">
        <a href="/" class="header-logo-panel" aria-label="BRU AVTOPARK Home">
            <span class="logo-icon" aria-hidden="true"></span>
            <span class="logo-text">BRU AVTOPARK</span>
        </a>
        <div class="header-controls-panel">
            <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode" type="button">
                <span class="theme-icon-light" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="5"/>
                        <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
                    </svg>
                </span>
                <span class="theme-icon-dark" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                    </svg>
                </span>
            </button>
        </div>
    </header>
    
    <div class="container" style="max-width: 1200px;">
        <div class="page-header">
            <div>
                <h1 class="page-title" style="display: flex; align-items: center; gap: 12px;">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                    OAuth 2.0 / OpenID Connect
                </h1>
                <p class="page-subtitle">Manage your OAuth 2.0 and OpenID Connect client applications</p>
            </div>
            <a href="/api/auth/connect/clients/new@(tokenParam)" class="btn btn--primary" style="width: auto;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                <span>New Client</span>
            </a>
        </div>

        @if (clients.Count > 0)
        {
            <div class="clients-grid">
                @foreach (var client in clients)
                {
                    var displayName = client.DisplayName ?? client.ClientId;
                    var firstLetter = displayName.Substring(0, 1).ToUpper();
                    
                    <article class="client-card fade-in">
                        <div class="client-card-header">
                            <div class="client-icon" aria-hidden="true">@firstLetter</div>
                            <div class="client-info">
                                <h2 class="client-name" title="@displayName">@displayName</h2>
                                <div class="client-id" title="@client.ClientId">@client.ClientId</div>
                            </div>
                        </div>
                        <div class="client-actions">
                            <a href="@($"/api/auth/connect/clients/{System.Web.HttpUtility.UrlEncode(client.ClientId)}{tokenParam}")" class="client-action-btn client-action-view">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right: 4px;">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                                View
                            </a>
                            <a href="@($"/api/auth/connect/clients/{System.Web.HttpUtility.UrlEncode(client.ClientId)}/edit{tokenParam}")" class="client-action-btn client-action-edit">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right: 4px;">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                </svg>
                                Edit
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="card fade-in">
                <div class="card__body empty-state">
                    <div style="width: 80px; height: 80px; margin: 0 auto 1.5rem; background: var(--info-bg); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        </svg>
                    </div>
                    <h2 style="margin-bottom: 1rem; color: var(--text-color);">No OAuth Clients Yet</h2>
                    <p style="color: var(--text-muted); margin-bottom: 1.5rem; max-width: 320px; margin-left: auto; margin-right: auto;">Get started by creating your first OAuth 2.0 / OpenID Connect client application.</p>
                    <a href="/api/auth/connect/clients/new@(tokenParam)" class="btn btn--primary" style="width: auto;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="12" y1="5" x2="12" y2="19"/>
                            <line x1="5" y1="12" x2="19" y2="12"/>
                        </svg>
                        <span>Create Your First Client</span>
                    </a>
                </div>
            </div>
        }
        
        <div class="mt-8 text-center">
            <a href="/api/auth/profile@(tokenParam)" class="link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 4px;" aria-hidden="true">
                    <line x1="19" y1="12" x2="5" y2="12"/>
                    <polyline points="12 19 5 12 12 5"/>
                </svg>
                Back to Profile
            </a>
        </div>
    </div>
    
    <script src="~/js/theme-toggle.js" defer></script>
    <script src="~/js/header-scroll.js" defer></script>
</body>
</html>
