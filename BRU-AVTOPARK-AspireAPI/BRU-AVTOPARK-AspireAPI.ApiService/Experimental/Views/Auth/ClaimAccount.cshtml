@* Claim Account View *@
@model dynamic

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Claim Account - BRU ID";
    ViewData["BodyClass"] = "auth-page-body";
    var error = Model?.Error as string;
    var message = Model?.Message as string;
}

<div class="login-container fade-in">
    <div class="card card--dark">
        <div class="card__body">
            <partial name="_BruIdHeader" />

            <h1 class="auth-title">Claim Your Account</h1>
            <p class="auth-subtitle">Link your identity to an existing account</p>

            <partial name="_StatusMessages"
                     model="new StatusViewModel(error, message)" />

            <div class="info-banner">
                <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                </svg>
                <span>Provide your username and set a new password to securely link your identity to the account.</span>
            </div>

            <form method="POST" action="/api/auth/claim-account" novalidate>
                <partial name="_FormField"
                         model='new FormFieldViewModel("username", "Username", Placeholder: "Enter your username", Required: true)' />

                <partial name="_FormField"
                         model='new FormFieldViewModel("password", "Password", Type: "password", Placeholder: "Enter a new password", Required: true)' />

                <partial name="_FormField"
                         model='new FormFieldViewModel("confirmPassword", "Confirm Password", Type: "password", Placeholder: "Confirm your password", Required: true)' />

                <label class="checkbox-row">
                    <input type="checkbox" name="generateNewIdentity" value="true" checked class="checkbox-input">
                    <span class="checkbox-label-text">Generate new identity (recommended)</span>
                </label>

                <button type="submit" class="btn btn--auth-primary">
                    <span>Claim Account</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="5" y1="12" x2="19" y2="12"/>
                        <polyline points="12 5 19 12 12 19"/>
                    </svg>
                </button>
            </form>

            <div class="divider"><span>or</span></div>

            <a href="/api/auth/login" class="btn btn--secondary btn-full">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="19" y1="12" x2="5" y2="12"/>
                    <polyline points="12 19 5 12 12 5"/>
                </svg>
                <span>Back to Login</span>
            </a>
        </div>
    </div>

    <partial name="_AuthFooterLinks" />
</div>
