@using BRU_AVTOPARK.Models.ViewModels
@model dynamic
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Magic Link - BRU ID";
    ViewData["BodyClass"] = "auth-page-body";
    var error = Model?.Error as string;
    var message = Model?.Message as string;
}

<div class="login-container fade-in">
    <div class="card card--dark">
        <div class="card__body">
            <partial name="_BruIdHeader" />

            <h1 class="auth-title">Magic Link Login</h1>
            <p class="auth-subtitle">Sign in without a password</p>

            <partial name="_StatusMessages"
                     model="new StatusViewModel(error, message)" />

            <div class="info-banner">
                <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
                    <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
                </svg>
                <span>Enter your email to receive a secure login link. No password required — just click the link in your email.</span>
            </div>

            <form method="POST" action="/api/auth/magic-link/send" novalidate>
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email"
                           id="email"
                           name="email"
                           placeholder="Enter your email address"
                           required
                           autocomplete="email" />
                </div>

                <button type="submit" class="btn btn--auth-primary">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="22" y1="2" x2="11" y2="13"/>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                    </svg>
                    <span>Send Magic Link</span>
                </button>
            </form>

            <div class="divider"><span>or</span></div>

            <a href="/api/auth/login" class="secondary-option">
                <svg class="secondary-option__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="19" y1="12" x2="5" y2="12"/>
                    <polyline points="12 19 5 12 12 5"/>
                </svg>
                <span>Back to Login</span>
            </a>
        </div>
    </div>

    <partial name="_AuthFooterLinks" />
</div>
