@* Error Page View - Modern glass design *@
@model dynamic

@{
    var errorMessage = Model?.ErrorMessage ?? "An error occurred";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0066ff">
    <title>Error - BRU AVTOPARK</title>
    <link rel="stylesheet" href="~/css/bru-design-system.css">
    <style>html{background-color:#121212}html[data-theme="light"]{background-color:#F0F0F0}</style>
    <script>(function(){var t=localStorage.getItem('theme')||(window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');document.documentElement.setAttribute('data-theme',t);var m=document.querySelector('meta[name="theme-color"]');if(m)m.setAttribute('content',t==='dark'?'#121212':'#F0F0F0');})()</script>
</head>
<body class="auth-page-body">
    <header class="header-wrapper" role="navigation">
        <a href="/" class="header-logo-panel" aria-label="BRU AVTOPARK Home">
            <span class="logo-icon" aria-hidden="true"></span>
            <span class="logo-text">BRU AVTOPARK</span>
        </a>
        <div class="header-controls-panel">
            <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode" type="button">
                <span class="theme-icon-light" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="5"/>
                        <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
                    </svg>
                </span>
                <span class="theme-icon-dark" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                    </svg>
                </span>
            </button>
        </div>
    </header>
    
    <div class="login-container">
        <div class="card fade-in">
            <div class="card__body text-center">
                <div style="margin-bottom: 1.5rem; animation: scaleIn 0.5s ease-out;">
                    <div style="width: 80px; height: 80px; margin: 0 auto; background: var(--error-bg); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--error-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"/>
                            <line x1="15" y1="9" x2="9" y2="15"/>
                            <line x1="9" y1="9" x2="15" y2="15"/>
                        </svg>
                    </div>
                </div>
                <h1 style="color: var(--error-color); margin-bottom: 1rem; font-size: 1.5rem;">Authentication Error</h1>
                <p style="color: var(--text-muted); margin-bottom: 2rem; max-width: 320px; margin-left: auto; margin-right: auto;">@errorMessage</p>
                <a href="/api/auth/login" class="btn btn--primary" style="width: auto; min-width: 160px;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="19" y1="12" x2="5" y2="12"/>
                        <polyline points="12 19 5 12 12 5"/>
                    </svg>
                    <span>Back to Login</span>
                </a>
            </div>
        </div>
    </div>
    
    <script src="~/js/theme-toggle.js" defer></script>
    <script src="~/js/header-scroll.js" defer></script>
</body>
</html>
