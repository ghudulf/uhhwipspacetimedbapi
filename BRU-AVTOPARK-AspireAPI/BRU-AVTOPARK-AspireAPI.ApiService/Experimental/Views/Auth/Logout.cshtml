@* Logout Page View - Modern glass design *@

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0066ff">
    <title>Logged Out - BRU AVTOPARK</title>
    <link rel="stylesheet" href="~/css/bru-design-system.css">
</head>
<body class="auth-page-body">
    <header class="header-wrapper" role="navigation">
        <a href="/" class="header-logo-panel" aria-label="BRU AVTOPARK Home">
            <span class="logo-icon" aria-hidden="true"></span>
            <span class="logo-text">BRU AVTOPARK</span>
        </a>
        <div class="header-controls-panel">
            <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode" type="button">
                <span class="theme-icon-light" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="5"/>
                        <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
                    </svg>
                </span>
                <span class="theme-icon-dark" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                    </svg>
                </span>
            </button>
        </div>
    </header>
    
    <div class="login-container">
        <div class="card fade-in">
            <div class="card__body text-center">
                <div style="margin-bottom: 1.5rem; animation: scaleIn 0.5s ease-out;">
                    <div style="width: 80px; height: 80px; margin: 0 auto; background: var(--success-bg); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--success-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                            <polyline points="16 17 21 12 16 7"/>
                            <line x1="21" y1="12" x2="9" y2="12"/>
                        </svg>
                    </div>
                </div>
                <h1 style="color: var(--success-color); margin-bottom: 1rem; font-size: 1.5rem;">You Have Been Logged Out</h1>
                <p style="color: var(--text-muted); margin-bottom: 2rem; max-width: 320px; margin-left: auto; margin-right: auto;">
                    You have been successfully logged out of your account. All authentication tokens have been cleared.
                </p>
                <button type="button" onclick="window.location.href='/api/auth/login'" class="btn btn-primary" style="min-width: 200px;">
                    Login Again
                </button>
            </div>
        </div>
    </div>
    
    <script src="~/js/theme-toggle.js" defer></script>
    <script src="~/js/header-scroll.js" defer></script>
    <script>
        // Clear authentication tokens
        localStorage.removeItem('auth_token');
        sessionStorage.removeItem('auth_token');
        
        // Clear any other auth-related data
        localStorage.removeItem('user_data');
        sessionStorage.removeItem('user_data');
        
        // Clear all session storage
        sessionStorage.clear();
    </script>
</body>
</html>
