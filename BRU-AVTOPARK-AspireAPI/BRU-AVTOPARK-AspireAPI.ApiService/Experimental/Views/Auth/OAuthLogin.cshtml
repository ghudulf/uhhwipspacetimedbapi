@using BRU_AVTOPARK.Models.ViewModels
@model OAuthLoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Authorize Application";
    ViewData["BodyClass"] = "auth-page-body";
    var requestId = Model?.RequestId ?? "";
    var clientName = Model?.ClientName ?? "Unknown Application";
    var scopes = Model?.Scopes ?? new string[] { };
    var error = Model?.Error;
}

@functions {
    string GetScopeDescription(string scope)
    {
        return scope switch
        {
            "openid" => "Verify your identity",
            "profile" => "Access your profile information",
            "email" => "Access your email address",
            "roles" => "Access your roles and permissions",
            "offline_access" => "Access your data when you're not using the app",
            _ => scope
        };
    }

    string GetScopeIcon(string scope)
    {
        return scope switch
        {
            "openid" => "M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z",
            "profile" => "M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z",
            "email" => "M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z",
            "roles" => "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
            "offline_access" => "M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15",
            _ => "M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
        };
    }
}

<div class="login-container fade-in">
    <div class="card card--dark">
        <div class="card__body">
            <partial name="_BruIdHeader" />

            <h1 class="auth-title">Authorize Application</h1>
            <p class="auth-subtitle"><strong>@clientName</strong> wants to access your account</p>

            <partial name="_StatusMessages"
                     model="new StatusViewModel(error, null)" />

            <!-- Step indicator -->
            <div class="oauth-steps" aria-label="Sign-in steps">
                <div class="oauth-step oauth-step--active" id="stepDot1" aria-current="step">
                    <span class="oauth-step__dot"></span>
                    <span class="oauth-step__label">Username</span>
                </div>
                <div class="oauth-step__connector"></div>
                <div class="oauth-step" id="stepDot2">
                    <span class="oauth-step__dot"></span>
                    <span class="oauth-step__label">Password</span>
                </div>
                <div class="oauth-step__connector"></div>
                <div class="oauth-step" id="stepDot3">
                    <span class="oauth-step__dot"></span>
                    <span class="oauth-step__label">Authorize</span>
                </div>
            </div>

            <form method="POST" action="/connect/authorize/callback" id="oauthLoginForm" novalidate>
                <input type="hidden" name="requestId" value="@requestId">
                <!-- Hidden username field so it's always submitted with the form -->
                <input type="hidden" name="username" id="usernameHidden">
                <!-- Hidden password field so it's always submitted with the form -->
                <input type="hidden" name="password" id="passwordHidden">

                <!-- Step 1: Username -->
                <div id="stepUsername" class="oauth-form-step">
                    <div class="form-group">
                        <label class="form-label" for="usernameInput">Username</label>
                        <input
                            type="text"
                            id="usernameInput"
                            name="_username_visible"
                            class="form-input"
                            placeholder="Enter your username"
                            autocomplete="username"
                            required
                            autofocus />
                    </div>
                    <button type="button" class="btn btn--auth-primary" id="btnNextStep" onclick="oauthStepNext()">
                        <span>Continue</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="9 18 15 12 9 6"/>
                        </svg>
                    </button>
                </div>

                <!-- Step 2: Password (hidden initially) -->
                <div id="stepPassword" class="oauth-form-step" style="display:none">
                    <!-- Username chip showing who is signing in -->
                    <div class="oauth-user-chip" id="userChip">
                        <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                            <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                        </svg>
                        <span id="userChipName"></span>
                        <button type="button" class="oauth-user-chip__change" onclick="oauthStepBack()" aria-label="Change username">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                                <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                            </svg>
                        </button>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="passwordInput">Password</label>
                        <input
                            type="password"
                            id="passwordInput"
                            name="_password_visible"
                            class="form-input"
                            placeholder="Enter your password"
                            autocomplete="current-password"
                            required />
                    </div>
                    <button type="button" class="btn btn--auth-primary" id="btnToConsent" onclick="oauthStepToConsent()">
                        <span>Next</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="9 18 15 12 9 6"/>
                        </svg>
                    </button>
                </div>

                <!-- Step 3: Consent (hidden initially) -->
                <div id="stepConsent" class="oauth-form-step" style="display:none">
                    <!-- Username chip -->
                    <div class="oauth-user-chip" id="userChipConsent">
                        <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                            <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                        </svg>
                        <span id="userChipNameConsent"></span>
                        <button type="button" class="oauth-user-chip__change" onclick="oauthStepBack2()" aria-label="Change password">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                                <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                            </svg>
                        </button>
                    </div>

                    @if (scopes != null && scopes.Length > 0)
                    {
                        <div class="oauth-scopes">
                            <h3 class="oauth-scopes__title">This application will be able to:</h3>
                            <ul class="oauth-scopes__list">
                                @foreach (var scope in scopes)
                                {
                                    <li class="oauth-scopes__item">
                                        <svg class="oauth-scopes__icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                            <path fill-rule="evenodd" d="@GetScopeIcon(scope)" clip-rule="evenodd"/>
                                        </svg>
                                        <span>@GetScopeDescription(scope)</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    <button type="submit" class="btn btn--auth-primary">
                        <span>Authorize</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                    </button>
                </div>
            </form>

            <div class="divider">
                <span>or</span>
            </div>

            <a href="/api/auth/login" class="btn btn--secondary">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="18" y1="6" x2="6" y2="18"/>
                    <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
                <span>Cancel and return to login</span>
            </a>
        </div>
    </div>

    <partial name="_AuthFooterLinks" />
</div>

<script>
(function () {
    'use strict';

    // ── helpers ──────────────────────────────────────────────────────────────
    function setStep(n) {
        ['stepUsername', 'stepPassword', 'stepConsent'].forEach(function (id, i) {
            var el = document.getElementById(id);
            if (el) el.style.display = (i === n - 1) ? '' : 'none';
        });
        // Update step dots
        [1, 2, 3].forEach(function (i) {
            var dot = document.getElementById('stepDot' + i);
            if (!dot) return;
            dot.classList.toggle('oauth-step--active', i === n);
            dot.classList.toggle('oauth-step--done', i < n);
            if (i === n) dot.setAttribute('aria-current', 'step');
            else dot.removeAttribute('aria-current');
        });
    }

    function getUsername() {
        return (document.getElementById('usernameInput') || {}).value || '';
    }

    // ── step navigation ───────────────────────────────────────────────────────
    window.oauthStepNext = function () {
        var username = getUsername().trim();
        if (!username) {
            document.getElementById('usernameInput').focus();
            return;
        }
        // Sync to hidden field
        document.getElementById('usernameHidden').value = username;
        // Show username chip
        document.getElementById('userChipName').textContent = username;
        document.getElementById('userChipNameConsent').textContent = username;
        setStep(2);
        setTimeout(function () {
            var pw = document.getElementById('passwordInput');
            if (pw) pw.focus();
        }, 50);
    };

    window.oauthStepBack = function () {
        setStep(1);
        setTimeout(function () {
            var u = document.getElementById('usernameInput');
            if (u) u.focus();
        }, 50);
    };

    window.oauthStepToConsent = function () {
        var password = (document.getElementById('passwordInput') || {}).value || '';
        if (!password) {
            document.getElementById('passwordInput').focus();
            return;
        }
        // Sync to hidden field
        document.getElementById('passwordHidden').value = password;
        setStep(3);
    };

    window.oauthStepBack2 = function () {
        setStep(2);
        setTimeout(function () {
            var pw = document.getElementById('passwordInput');
            if (pw) pw.focus();
        }, 50);
    };

    // ── keyboard support ──────────────────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', function () {
        var usernameInput = document.getElementById('usernameInput');
        var passwordInput = document.getElementById('passwordInput');

        if (usernameInput) {
            usernameInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') { e.preventDefault(); oauthStepNext(); }
            });
        }
        if (passwordInput) {
            passwordInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') { e.preventDefault(); oauthStepToConsent(); }
            });
        }

        // Ensure hidden fields are populated on submit (in case JS ran out of order)
        var form = document.getElementById('oauthLoginForm');
        if (form) {
            form.addEventListener('submit', function () {
                document.getElementById('usernameHidden').value = getUsername().trim() ||
                    document.getElementById('usernameHidden').value;
                document.getElementById('passwordHidden').value =
                    (document.getElementById('passwordInput') || {}).value ||
                    document.getElementById('passwordHidden').value;
            });
        }
    });
})();
</script>

<style>
    /* Step indicator */
    .oauth-steps {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0;
        margin: 1.25rem 0 1.75rem;
    }

    .oauth-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.35rem;
    }

    .oauth-step__dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--border-color, #444);
        transition: background 0.25s, transform 0.25s;
        display: block;
    }

    .oauth-step--active .oauth-step__dot {
        background: var(--primary-color, #6366f1);
        transform: scale(1.35);
    }

    .oauth-step--done .oauth-step__dot {
        background: var(--success-color, #22c55e);
    }

    .oauth-step__label {
        font-size: 0.7rem;
        color: var(--text-secondary, #888);
        white-space: nowrap;
    }

    .oauth-step--active .oauth-step__label {
        color: var(--primary-color, #6366f1);
        font-weight: 600;
    }

    .oauth-step--done .oauth-step__label {
        color: var(--success-color, #22c55e);
    }

    .oauth-step__connector {
        flex: 1;
        height: 2px;
        min-width: 2rem;
        background: var(--border-color, #444);
        margin-bottom: 1.1rem;
        transition: background 0.25s;
    }

    /* Username chip */
    .oauth-user-chip {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.45rem 0.85rem;
        background: var(--surface-elevated, #1e1e2e);
        border: 1px solid var(--border-color, #444);
        border-radius: 999px;
        margin-bottom: 1.25rem;
        width: fit-content;
        font-size: 0.875rem;
        color: var(--text-color, #e2e8f0);
    }

    .oauth-user-chip__change {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0.1rem;
        color: var(--text-secondary, #888);
        display: flex;
        align-items: center;
        border-radius: 4px;
        transition: color 0.15s;
    }

    .oauth-user-chip__change:hover {
        color: var(--primary-color, #6366f1);
    }

    /* Scoped OAuth permissions styling */
    .oauth-scopes {
        margin: 1.25rem 0;
        padding: 1.25rem;
        background: var(--surface-elevated);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
    }

    .oauth-scopes__title {
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--text-secondary);
        margin: 0 0 1rem 0;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .oauth-scopes__list {
        list-style: none !important;
        padding: 0 !important;
        margin: 0 !important;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .oauth-scopes__item {
        display: flex !important;
        align-items: flex-start;
        gap: 1rem;
        padding: 0 !important;
        list-style: none !important;
        list-style-type: none !important;
    }

    .oauth-scopes__item::before,
    .oauth-scopes__item::marker {
        display: none !important;
        content: none !important;
    }

    .oauth-scopes__icon {
        flex-shrink: 0;
        margin-top: 2px;
        color: var(--primary-color);
        opacity: 0.9;
    }

    .oauth-scopes__item span {
        font-size: 0.9375rem;
        color: var(--text-color);
        line-height: 1.5;
        flex: 1;
    }

    /* Step transition */
    .oauth-form-step {
        animation: stepFadeIn 0.2s ease;
    }

    @@keyframes stepFadeIn {
        from { opacity: 0; transform: translateY(6px); }
        to   { opacity: 1; transform: translateY(0); }
    }
</style>
