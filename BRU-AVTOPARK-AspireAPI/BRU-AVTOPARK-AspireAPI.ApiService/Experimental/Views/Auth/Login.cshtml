@using BRU_AVTOPARK.Models.ViewModels
@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login";
    ViewData["BodyClass"] = "auth-page-body";
}

<div class="login-container fade-in">
    <div class="card card--dark">
        <div class="card__body">
            <partial name="_BruIdHeader" />

            <h1 class="auth-title">Sign in with BRU ID</h1>

            <partial name="_StatusMessages"
                     model="new StatusViewModel(Model.Error, Model.Message)" />

            <form method="POST" action="/api/auth/login" id="loginForm" novalidate>
                <partial name="_FormField"
                         model='new FormFieldViewModel("username", "Username", Placeholder: "Enter your username", Required: true)' />

                <partial name="_FormField"
                         model='new FormFieldViewModel("password", "Password", Type: "password", Placeholder: "Enter your password", Required: true)' />

                <button type="button" class="btn btn--auth-primary" id="loginButton" onclick="submitLoginForm()">
                    <span>Sign in</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="5" y1="12" x2="19" y2="12"/>
                        <polyline points="12 5 19 12 12 19"/>
                    </svg>
                </button>

                @* Secondary authentication options *@
                <button type="button" class="secondary-option" data-href="/api/auth/webauthn/login" aria-label="Login with Security Key">
                    <svg class="secondary-option__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
                        <circle cx="12" cy="12" r="3"/>
                    </svg>
                    <span>Login with Security Key</span>
                </button>

                <button type="button" class="secondary-option" data-href="/api/auth/qr/login" aria-label="Login with QR Code">
                    <svg class="secondary-option__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="3" width="7" height="7"/>
                        <rect x="14" y="3" width="7" height="7"/>
                        <rect x="14" y="14" width="7" height="7"/>
                        <rect x="3" y="14" width="7" height="7"/>
                    </svg>
                    <span>Login with QR Code</span>
                </button>
            </form>

            <div id="statusDiv" class="mt-4" aria-live="polite"></div>

            <div class="divider">
                <span>or continue with</span>
            </div>

            <div class="social-buttons">
                <button class="social-button" aria-label="Login with phone number" type="button">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                        <line x1="12" y1="18" x2="12.01" y2="18"></line>
                    </svg>
                </button>
                <button class="social-button" aria-label="Login with Google account" type="button">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"></path>
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"></path>
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"></path>
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"></path>
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <partial name="_AuthFooterLinks" />
</div>

@* Auto-login overlay for returning users with cached tokens *@
<div id="autoLoginOverlay" class="auto-login-overlay" style="display:none;" aria-hidden="true">
    <div class="auto-login-overlay__content">
        <div class="loader" aria-label="Loading"></div>
        <h2 class="auto-login-overlay__title">Welcome back!</h2>
        <p class="auto-login-overlay__subtitle">Redirecting to your profile...</p>
    </div>
</div>

@section Scripts {
    <script src="~/js/auth/login.js" defer></script>
}
