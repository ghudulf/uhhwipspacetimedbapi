<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.1" />
    <!-- Retain the SQLite provider while pinning its patched native library. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.2.0" />
    <PackageReference Include="System.Text.Encodings.Web" Version="4.7.2" />
    <!-- Keep the OpenIddict 4.1 contract, with patched IdentityModel dependencies for standalone service consumers. -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="6.34.0" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="6.34.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="SpacetimeDB.ClientSDK" Version="2.1.0" />
    <PackageReference Include="Fido2" Version="3.0.1" />
    <PackageReference Include="Fido2.Models" Version="3.0.1" />
    <PackageReference Include="OpenIddict.Core" Version="4.1.0" />
    <PackageReference Include="OpenIddict.Server.AspNetCore" Version="4.1.0" />
    <PackageReference Include="OpenIddict.Validation.AspNetCore" Version="4.1.0" />
    
  </ItemGroup>

 

<ItemGroup><Compile Include="../../server/PermissionNames.cs" Link="Authorization/PermissionNames.cs" /></ItemGroup>
<ItemGroup><ProjectReference Include="../../shared/BRU.Avtopark.Contracts/BRU.Avtopark.Contracts.csproj" /></ItemGroup>
</Project>
